<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wintodo.Controls.TaskListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Wintodo.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Wintodo.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:Wintodo.ViewModels"
    x:Name="Root"
    d:DesignHeight="720"
    d:DesignWidth="640"
    IsTabStop="False"
    mc:Ignorable="d">

    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="OnFocusComposerAccelerator" />
        <KeyboardAccelerator Key="Enter" Invoked="OnOpenDetailAccelerator" />
        <KeyboardAccelerator Key="Space" Invoked="OnToggleCompletionAccelerator" />
        <KeyboardAccelerator Key="I" Modifiers="Control" Invoked="OnToggleImportanceAccelerator" />
        <KeyboardAccelerator Key="T" Modifiers="Control" Invoked="OnToggleMyDayAccelerator" />
        <KeyboardAccelerator Key="Delete" Invoked="OnDeleteAccelerator" />
        <KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="OnUndoAccelerator" />
        <KeyboardAccelerator Key="F2" Invoked="OnRenameAccelerator" />
        <KeyboardAccelerator Key="Up" Modifiers="Menu" Invoked="OnMoveUpAccelerator" />
        <KeyboardAccelerator Key="Down" Modifiers="Menu" Invoked="OnMoveDownAccelerator" />
        <KeyboardAccelerator Key="Up" Invoked="OnSelectPreviousAccelerator" />
        <KeyboardAccelerator Key="Down" Invoked="OnSelectNextAccelerator" />
    </UserControl.KeyboardAccelerators>

    <UserControl.Resources>
        <CollectionViewSource
            x:Name="TasksCollectionViewSource"
            IsSourceGrouped="True" />

        <!--
            ListViewItemPresenter draws its chrome square regardless of the item's
            CornerRadius, so the row card is templated here instead. Rounding must
            match the composer above the list.
        -->
        <Style x:Key="TaskListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="FocusVisualMargin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border
                            x:Name="ItemCard"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="StateOverlay.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="StateOverlay.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Target="StateOverlay.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PointerOverSelected">
                                        <VisualState.Setters>
                                            <Setter Target="StateOverlay.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PressedSelected">
                                        <VisualState.Setters>
                                            <Setter Target="StateOverlay.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="DisabledStates">
                                    <VisualState x:Name="Enabled" />
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="ItemCard.Opacity" Value="{ThemeResource ListViewItemDisabledThemeOpacity}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="DragStates">
                                    <VisualState x:Name="NotDragging" />
                                    <VisualState x:Name="Dragging">
                                        <VisualState.Setters>
                                            <Setter Target="ItemCard.Opacity" Value="{ThemeResource ListViewItemDragThemeOpacity}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid>
                                <Border
                                    x:Name="StateOverlay"
                                    Background="{ThemeResource SubtleFillColorTransparentBrush}"
                                    CornerRadius="{TemplateBinding CornerRadius}" />
                                <ContentPresenter
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTransitions="{TemplateBinding ContentTransitions}" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TaskGroupHeaderContainerStyle" TargetType="ListViewHeaderItem">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Background" Value="{ThemeResource ListViewHeaderItemBackground}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewHeaderItem">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Background="{TemplateBinding Background}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentTransitions="{TemplateBinding ContentTransitions}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate
            x:Key="TaskRowTemplate"
            x:DataType="viewModels:TaskItemViewModel">
            <controls:TaskRow ViewModel="{x:Bind Mode=OneWay}" />
        </DataTemplate>

        <DataTemplate
            x:Key="GroupHeaderTemplate"
            x:DataType="x:Object">
            <Grid
                MinHeight="{x:Bind local:TaskListView.GroupHeaderMinHeightForItems((x:Object)), Mode=OneTime}"
                AutomationProperties.AccessibilityView="Raw">
                <Grid
                    Margin="0,8,0,0"
                    ColumnSpacing="8"
                    Visibility="{x:Bind local:TaskListView.NamedGroupVisibilityForItems((x:Object)), Mode=OneTime}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        AutomationProperties.AutomationId="{x:Bind local:TaskListView.GroupAutomationId((x:Object)), Mode=OneTime}"
                        Foreground="{x:Bind local:TaskListView.GroupHeaderBrushForItems((x:Object)), Mode=OneTime}"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind local:TaskListView.GroupTitle((x:Object)), Mode=OneTime}" />
                    <TextBlock
                        Grid.Column="1"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind local:TaskListView.GroupHeaderCount((x:Object)), Mode=OneTime}" />
                </Grid>
                <ToggleButton
                    Margin="0,16,0,8"
                    MinHeight="40"
                    Padding="12,0"
                    HorizontalAlignment="Left"
                    HorizontalContentAlignment="Left"
                    VerticalContentAlignment="Center"
                    AutomationProperties.AutomationId="{x:Bind local:TaskListView.GroupAutomationId((x:Object)), Mode=OneTime}"
                    AutomationProperties.Name="{x:Bind local:TaskListView.GroupAccessibleName((x:Object)), Mode=OneTime}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    Command="{x:Bind local:TaskListView.GroupToggleCommand((x:Object)), Mode=OneTime}"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    IsChecked="{x:Bind local:TaskListView.GroupIsExpanded((x:Object)), Mode=OneTime}"
                    Style="{StaticResource TaskSubtleToggleButtonStyle}"
                    Visibility="{x:Bind local:TaskListView.CompletedGroupVisibilityForItems((x:Object)), Mode=OneTime}">
                    <!--
                        These must be real brushes, not StaticResource aliases.
                        A header container is recycled every time the group is
                        expanded again, and the ThemeResource update pass cannot
                        dereference an alias entry: it resolves to Unknown and
                        XAML fail-fasts with "Invalid attribute value Unknown
                        for property Foreground" (0x800F1001).
                    -->
                    <ToggleButton.Resources>
                        <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="{ThemeResource CardBackgroundFillColorSecondary}" />
                        <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="{ThemeResource SubtleFillColorTertiary}" />
                        <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{ThemeResource CardBackgroundFillColorDefault}" />
                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{ThemeResource CardBackgroundFillColorSecondary}" />
                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{ThemeResource SubtleFillColorTertiary}" />
                        <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{ThemeResource TextFillColorPrimary}" />
                        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="{ThemeResource TextFillColorPrimary}" />
                        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="{ThemeResource TextFillColorSecondary}" />
                    </ToggleButton.Resources>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Grid.Column="0"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="{ThemeResource ControlContentThemeFontSize}"
                            Glyph="{x:Bind local:TaskListView.GroupCompletedChevron((x:Object)), Mode=OneTime}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind local:TaskListView.GroupTitle((x:Object)), Mode=OneTime}" />
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind local:TaskListView.GroupHeaderCount((x:Object)), Mode=OneTime}" />
                    </Grid>
                </ToggleButton>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Top" Spacing="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        Grid.ColumnSpan="2"
                        Height="44"
                        Orientation="Horizontal"
                        Spacing="8"
                        Visibility="{x:Bind local:TaskListView.InverseBoolToVisibility(ViewModel.CanEditSelectedList), Mode=OneWay}">
                        <FontIcon
                            x:Name="FixedHeaderIcon"
                            Width="44"
                            Height="44"
                            AutomationProperties.AccessibilityView="Raw"
                            AutomationProperties.AutomationId="Todo.List.FixedHeaderIcon"
                            FontSize="{StaticResource ListHeaderIconSize}"
                            Foreground="{x:Bind ViewModel.FixedHeaderIconBrush, Mode=OneWay}"
                            Glyph="{x:Bind ViewModel.FixedHeaderGlyph, Mode=OneWay}"
                            Visibility="{x:Bind local:TaskListView.BoolToVisibility(ViewModel.HasFixedHeaderGlyph), Mode=OneWay}" />
                        <TextBlock
                            x:Name="SmartListTitle"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="Todo.Shell.PageTitle"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            Style="{StaticResource TitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button
                        x:Name="ListIconPickerButton"
                        x:Uid="ListIconPickerButton"
                        Grid.Column="0"
                        Width="44"
                        Height="44"
                        MinWidth="0"
                        Padding="0"
                        AutomationProperties.AutomationId="Todo.List.IconPickerButton"
                        BorderThickness="{ThemeResource ListHeaderButtonBorderThickness}"
                        Style="{StaticResource SubtleButtonStyle}"
                        Visibility="{x:Bind local:TaskListView.BoolToVisibility(ViewModel.CanEditSelectedList), Mode=OneWay}">
                        <Grid>
                            <SymbolIcon
                                Symbol="Emoji"
                                Visibility="{x:Bind local:TaskListView.InverseBoolToVisibility(ViewModel.HasSelectedIconEmoji), Mode=OneWay}" />
                            <TextBlock
                                AutomationProperties.AutomationId="Todo.List.HeaderIcon"
                                FontFamily="Segoe UI Emoji"
                                HorizontalAlignment="Center"
                                Style="{StaticResource TitleTextBlockStyle}"
                                Text="{x:Bind ViewModel.SelectedIconEmoji, Mode=OneWay}"
                                TextAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind local:TaskListView.BoolToVisibility(ViewModel.HasSelectedIconEmoji), Mode=OneWay}" />
                        </Grid>
                        <Button.Flyout>
                            <Flyout
                                x:Name="ListIconPickerFlyout"
                                Closed="OnListIconPickerClosed"
                                Placement="BottomEdgeAlignedLeft">
                                <StackPanel Width="260" Spacing="8">
                                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.ListIconChoices, Mode=OneWay}">
                                        <ItemsRepeater.Layout>
                                            <UniformGridLayout
                                                MinColumnSpacing="4"
                                                MinItemHeight="40"
                                                MinItemWidth="40"
                                                MinRowSpacing="4" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="viewModels:ListEmojiChoiceViewModel">
                                                <Button
                                                    Width="40"
                                                    Height="40"
                                                    Padding="0"
                                                    AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneTime}"
                                                    AutomationProperties.Name="{x:Bind Name, Mode=OneTime}"
                                                    Command="{x:Bind SelectCommand, Mode=OneTime}"
                                                    CommandParameter="{x:Bind Emoji, Mode=OneTime}"
                                                    Style="{StaticResource SubtleButtonStyle}"
                                                    ToolTipService.ToolTip="{x:Bind Name, Mode=OneTime}">
                                                    <TextBlock
                                                        FontFamily="Segoe UI Emoji"
                                                        FontSize="{StaticResource ListEmojiPickerIconSize}"
                                                        Text="{x:Bind Emoji, Mode=OneTime}" />
                                                </Button>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                    <Button
                                        x:Uid="ListIconPickerClear"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.AutomationId="Todo.List.IconPicker.Clear"
                                        Command="{x:Bind ViewModel.ChangeListIconCommand, Mode=OneTime}"
                                        CommandParameter="" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button
                        x:Name="UserListTitleButton"
                        Grid.Column="1"
                        HorizontalAlignment="Left"
                        Padding="8,0"
                        AutomationProperties.AutomationId="Todo.List.TitleButton"
                        BorderThickness="{ThemeResource ListHeaderButtonBorderThickness}"
                        Command="{x:Bind ViewModel.BeginRenameListCommand, Mode=OneTime}"
                        Style="{StaticResource SubtleButtonStyle}"
                        Visibility="{x:Bind local:TaskListView.TitleButtonVisibility(ViewModel.CanEditSelectedList, ViewModel.IsRenamingList), Mode=OneWay}">
                        <TextBlock
                            Foreground="{ThemeResource ListAccentBrush}"
                            Style="{StaticResource TitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </Button>
                    <!--
                        The editor keeps the title's own type ramp so the name does not
                        change size or jump when it turns editable.
                    -->
                    <local:TitleEditBox
                        x:Name="RenameListBox"
                        Grid.Column="1"
                        MinWidth="160"
                        Padding="8,4"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="Todo.List.RenameBox"
                        FontSize="28"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource ListAccentBrush}"
                        KeyDown="OnRenameListBoxKeyDown"
                        LostFocus="OnRenameListBoxLostFocus"
                        Text="{x:Bind ViewModel.RenameListName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{x:Bind local:TaskListView.BoolToVisibility(ViewModel.IsRenamingList), Mode=OneWay}" />
                </Grid>
                <TextBlock
                    AutomationProperties.AutomationId="Todo.Shell.Subtitle"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}"
                    Visibility="{x:Bind local:TaskListView.BoolToVisibility(ViewModel.HasSubtitle), Mode=OneWay}" />
            </StackPanel>

            <DropDownButton
                x:Name="SortButton"
                Grid.Column="1"
                AutomationProperties.AutomationId="Todo.List.SortButton"
                Style="{StaticResource SubtleButtonStyle}"
                Visibility="{x:Bind local:TaskListView.BoolToVisibility(ViewModel.AreListCommandsVisible), Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8CB;" />
                    <TextBlock
                        AutomationProperties.AutomationId="Todo.List.SortLabel"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind ViewModel.SortLabel, Mode=OneWay}" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem
                            x:Uid="SortManual"
                            AutomationProperties.AutomationId="Todo.List.Sort.Manual"
                            Command="{x:Bind ViewModel.SortByCommand, Mode=OneTime}"
                            CommandParameter="Manual" />
                        <MenuFlyoutItem
                            x:Uid="SortImportance"
                            AutomationProperties.AutomationId="Todo.List.Sort.Importance"
                            Command="{x:Bind ViewModel.SortByCommand, Mode=OneTime}"
                            CommandParameter="Importance" />
                        <MenuFlyoutItem
                            x:Uid="SortDueDate"
                            AutomationProperties.AutomationId="Todo.List.Sort.DueDate"
                            Command="{x:Bind ViewModel.SortByCommand, Mode=OneTime}"
                            CommandParameter="DueDate" />
                        <MenuFlyoutItem
                            x:Uid="SortAlphabetical"
                            AutomationProperties.AutomationId="Todo.List.Sort.Alphabetical"
                            Command="{x:Bind ViewModel.SortByCommand, Mode=OneTime}"
                            CommandParameter="Alphabetical" />
                        <MenuFlyoutItem
                            x:Uid="SortCreationDate"
                            AutomationProperties.AutomationId="Todo.List.Sort.CreationDate"
                            Command="{x:Bind ViewModel.SortByCommand, Mode=OneTime}"
                            CommandParameter="CreationDate" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem
                            x:Uid="SortReverse"
                            AutomationProperties.AutomationId="Todo.List.Sort.Reverse"
                            Command="{x:Bind ViewModel.ToggleSortDirectionCommand, Mode=OneTime}" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>

            <Button
                x:Name="ListMenuButton"
                x:Uid="ListMenuButton"
                Grid.Column="2"
                Width="32"
                Height="32"
                Padding="0"
                AutomationProperties.AutomationId="Todo.List.MenuButton"
                Style="{StaticResource SubtleButtonStyle}"
                Visibility="{x:Bind local:TaskListView.BoolToVisibility(ViewModel.AreListCommandsVisible), Mode=OneWay}">
                <FontIcon Glyph="&#xE712;" />
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem
                            x:Uid="RenameListMenu"
                            AutomationProperties.AutomationId="Todo.List.Menu.Rename"
                            Command="{x:Bind ViewModel.BeginRenameListCommand, Mode=OneTime}"
                            IsEnabled="{x:Bind ViewModel.CanEditSelectedList, Mode=OneWay}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE70F;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSubItem
                            x:Uid="ChangeIconMenu"
                            AutomationProperties.AutomationId="Todo.List.Menu.ChangeIcon"
                            IsEnabled="{x:Bind ViewModel.CanEditSelectedList, Mode=OneWay}">
                            <MenuFlyoutSubItem.Icon>
                                <SymbolIcon Symbol="Emoji" />
                            </MenuFlyoutSubItem.Icon>
                            <MenuFlyoutItem
                                x:Uid="CustomListIconMenu"
                                AutomationProperties.AutomationId="Todo.List.Icon.Custom"
                                Command="{x:Bind ViewModel.RequestCustomListIconCommand, Mode=OneTime}" />
                            <MenuFlyoutItem
                                x:Uid="RemoveListIconMenu"
                                AutomationProperties.AutomationId="Todo.List.Icon.Remove"
                                Command="{x:Bind ViewModel.ChangeListIconCommand, Mode=OneTime}"
                                CommandParameter="" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSubItem
                            x:Uid="ChangeThemeMenu"
                            AutomationProperties.AutomationId="Todo.List.Menu.ChangeTheme"
                            IsEnabled="{x:Bind ViewModel.IsUserListSelected, Mode=OneWay}">
                            <MenuFlyoutSubItem.Icon>
                                <FontIcon Glyph="&#xE790;" />
                            </MenuFlyoutSubItem.Icon>
                            <MenuFlyoutItem
                                x:Uid="ThemeBlue"
                                AutomationProperties.AutomationId="Todo.List.Theme.Blue"
                                Command="{x:Bind ViewModel.ChangeListColorCommand, Mode=OneTime}"
                                CommandParameter="Blue">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Foreground="{ThemeResource ListAccentBlueBrush}" Glyph="&#xE915;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                x:Uid="ThemeRed"
                                AutomationProperties.AutomationId="Todo.List.Theme.Red"
                                Command="{x:Bind ViewModel.ChangeListColorCommand, Mode=OneTime}"
                                CommandParameter="Red">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Foreground="{ThemeResource ListAccentRedBrush}" Glyph="&#xE915;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                x:Uid="ThemeOrange"
                                AutomationProperties.AutomationId="Todo.List.Theme.Orange"
                                Command="{x:Bind ViewModel.ChangeListColorCommand, Mode=OneTime}"
                                CommandParameter="Orange">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Foreground="{ThemeResource ListAccentOrangeBrush}" Glyph="&#xE915;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                x:Uid="ThemeYellow"
                                AutomationProperties.AutomationId="Todo.List.Theme.Yellow"
                                Command="{x:Bind ViewModel.ChangeListColorCommand, Mode=OneTime}"
                                CommandParameter="Yellow">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Foreground="{ThemeResource ListAccentYellowBrush}" Glyph="&#xE915;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                x:Uid="ThemeGreen"
                                AutomationProperties.AutomationId="Todo.List.Theme.Green"
                                Command="{x:Bind ViewModel.ChangeListColorCommand, Mode=OneTime}"
                                CommandParameter="Green">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Foreground="{ThemeResource ListAccentGreenBrush}" Glyph="&#xE915;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                x:Uid="ThemeTeal"
                                AutomationProperties.AutomationId="Todo.List.Theme.Teal"
                                Command="{x:Bind ViewModel.ChangeListColorCommand, Mode=OneTime}"
                                CommandParameter="Teal">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Foreground="{ThemeResource ListAccentTealBrush}" Glyph="&#xE915;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                x:Uid="ThemeLime"
                                AutomationProperties.AutomationId="Todo.List.Theme.Lime"
                                Command="{x:Bind ViewModel.ChangeListColorCommand, Mode=OneTime}"
                                CommandParameter="Lime">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Foreground="{ThemeResource ListAccentLimeBrush}" Glyph="&#xE915;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                x:Uid="ThemePurple"
                                AutomationProperties.AutomationId="Todo.List.Theme.Purple"
                                Command="{x:Bind ViewModel.ChangeListColorCommand, Mode=OneTime}"
                                CommandParameter="Purple">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Foreground="{ThemeResource ListAccentPurpleBrush}" Glyph="&#xE915;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                x:Uid="ThemePink"
                                AutomationProperties.AutomationId="Todo.List.Theme.Pink"
                                Command="{x:Bind ViewModel.ChangeListColorCommand, Mode=OneTime}"
                                CommandParameter="Pink">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Foreground="{ThemeResource ListAccentPinkBrush}" Glyph="&#xE915;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                x:Uid="ThemeOlive"
                                AutomationProperties.AutomationId="Todo.List.Theme.Olive"
                                Command="{x:Bind ViewModel.ChangeListColorCommand, Mode=OneTime}"
                                CommandParameter="Olive">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Foreground="{ThemeResource ListAccentOliveBrush}" Glyph="&#xE915;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                x:Uid="ThemeGraphite"
                                AutomationProperties.AutomationId="Todo.List.Theme.Graphite"
                                Command="{x:Bind ViewModel.ChangeListColorCommand, Mode=OneTime}"
                                CommandParameter="Graphite">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Foreground="{ThemeResource ListAccentGraphiteBrush}" Glyph="&#xE915;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                x:Uid="ThemeNavy"
                                AutomationProperties.AutomationId="Todo.List.Theme.Navy"
                                Command="{x:Bind ViewModel.ChangeListColorCommand, Mode=OneTime}"
                                CommandParameter="Navy">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Foreground="{ThemeResource ListAccentNavyBrush}" Glyph="&#xE915;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSubItem
                            x:Uid="ChangeBackgroundMenu"
                            AutomationProperties.AutomationId="Todo.List.Menu.ChangeBackground"
                            IsEnabled="{x:Bind ViewModel.CanChangeSelectedBackground, Mode=OneWay}">
                            <MenuFlyoutSubItem.Icon>
                                <FontIcon Glyph="&#xEB9F;" />
                            </MenuFlyoutSubItem.Icon>
                            <MenuFlyoutItem
                                x:Uid="BackgroundNone"
                                AutomationProperties.AutomationId="Todo.List.Background.None"
                                Command="{x:Bind ViewModel.ChangeListBackgroundCommand, Mode=OneTime}"
                                CommandParameter="None" />
                            <MenuFlyoutItem
                                x:Uid="BackgroundCoast"
                                AutomationProperties.AutomationId="Todo.List.Background.Coast"
                                Command="{x:Bind ViewModel.ChangeListBackgroundCommand, Mode=OneTime}"
                                CommandParameter="Coast" />
                            <MenuFlyoutItem
                                x:Uid="BackgroundForest"
                                AutomationProperties.AutomationId="Todo.List.Background.Forest"
                                Command="{x:Bind ViewModel.ChangeListBackgroundCommand, Mode=OneTime}"
                                CommandParameter="Forest" />
                            <MenuFlyoutItem
                                x:Uid="BackgroundMist"
                                AutomationProperties.AutomationId="Todo.List.Background.Mist"
                                Command="{x:Bind ViewModel.ChangeListBackgroundCommand, Mode=OneTime}"
                                CommandParameter="Mist" />
                            <MenuFlyoutItem
                                x:Uid="BackgroundSunrise"
                                AutomationProperties.AutomationId="Todo.List.Background.Sunrise"
                                Command="{x:Bind ViewModel.ChangeListBackgroundCommand, Mode=OneTime}"
                                CommandParameter="Sunrise" />
                            <MenuFlyoutItem
                                x:Uid="BackgroundIndigo"
                                AutomationProperties.AutomationId="Todo.List.Background.Indigo"
                                Command="{x:Bind ViewModel.ChangeListBackgroundCommand, Mode=OneTime}"
                                CommandParameter="Indigo" />
                            <MenuFlyoutItem
                                x:Uid="BackgroundPetals"
                                AutomationProperties.AutomationId="Todo.List.Background.Petals"
                                Command="{x:Bind ViewModel.ChangeListBackgroundCommand, Mode=OneTime}"
                                CommandParameter="Petals" />
                            <MenuFlyoutItem
                                x:Uid="BackgroundGraphite"
                                AutomationProperties.AutomationId="Todo.List.Background.Graphite"
                                Command="{x:Bind ViewModel.ChangeListBackgroundCommand, Mode=OneTime}"
                                CommandParameter="Graphite" />
                            <MenuFlyoutItem
                                x:Uid="BackgroundField"
                                AutomationProperties.AutomationId="Todo.List.Background.Field"
                                Command="{x:Bind ViewModel.ChangeListBackgroundCommand, Mode=OneTime}"
                                CommandParameter="Field" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutItem
                            AutomationProperties.AutomationId="Todo.List.Menu.ShowCompleted"
                            Command="{x:Bind ViewModel.ToggleShowCompletedCommand, Mode=OneTime}"
                            IsEnabled="{x:Bind ViewModel.IsUserListSelected, Mode=OneWay}"
                            Text="{x:Bind ViewModel.ShowCompletedMenuLabel, Mode=OneWay}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8FB;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem
                            x:Uid="ShortcutsMenu"
                            AutomationProperties.AutomationId="Todo.List.Menu.Shortcuts"
                            Command="{x:Bind ViewModel.RequestShortcutsCommand, Mode=OneTime}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE765;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            x:Uid="ExportListMenu"
                            AutomationProperties.AutomationId="Todo.List.Menu.Export"
                            Command="{x:Bind ViewModel.RequestExportListCommand, Mode=OneTime}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE898;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            x:Uid="DeleteListMenu"
                            AutomationProperties.AutomationId="Todo.List.Menu.Delete"
                            Command="{x:Bind ViewModel.RequestDeleteListCommand, Mode=OneTime}"
                            IsEnabled="{x:Bind ViewModel.CanEditSelectedList, Mode=OneWay}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74D;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <controls:AddTaskComposer
            x:Name="Composer"
            Grid.Row="1"
            ViewModel="{x:Bind ViewModel, Mode=OneWay}"
            Visibility="{x:Bind local:TaskListView.BoolToVisibility(ViewModel.IsComposerVisible), Mode=OneWay}" />

        <Grid
            x:Name="TaskContent"
            Grid.Row="3"
            Visibility="{x:Bind local:TaskListView.BoolToVisibility(ViewModel.IsTaskListVisible), Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="5*" />
            </Grid.RowDefinitions>
            <ListView
                x:Name="TasksList"
                Grid.RowSpan="3"
                AutomationProperties.AutomationId="Todo.List.Tasks"
                AllowDrop="{x:Bind ViewModel.CanReorderTasks, Mode=OneWay}"
                CanDragItems="{x:Bind ViewModel.CanReorderTasks, Mode=OneWay}"
                CanReorderItems="{x:Bind ViewModel.CanReorderTasks, Mode=OneWay}"
                ContainerContentChanging="OnContainerContentChanging"
                DragItemsCompleted="OnDragItemsCompleted"
                DragItemsStarting="OnDragItemsStarting"
                IsItemClickEnabled="False"
                ItemContainerStyle="{StaticResource TaskListViewItemStyle}"
                ItemsSource="{x:Bind TasksCollectionViewSource.View, Mode=OneWay}"
                ItemTemplate="{StaticResource TaskRowTemplate}"
                PreviewKeyDown="OnTasksListPreviewKeyDown"
                SelectionChanged="OnTaskSelectionChanged"
                SelectionMode="Multiple">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel AreStickyGroupHeadersEnabled="True" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.GroupStyle>
                    <GroupStyle
                        HeaderContainerStyle="{StaticResource TaskGroupHeaderContainerStyle}"
                        HeaderTemplate="{StaticResource GroupHeaderTemplate}"
                        HidesIfEmpty="False" />
                </ListView.GroupStyle>
                <ListView.ItemContainerTransitions>
                    <TransitionCollection>
                        <AddDeleteThemeTransition />
                        <ReorderThemeTransition />
                    </TransitionCollection>
                </ListView.ItemContainerTransitions>
            </ListView>

            <StackPanel
                x:Name="EmptyState"
                Grid.Row="1"
                Width="320"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="4"
                x:Load="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                <FontIcon
                    Margin="0,0,0,12"
                    FontSize="{StaticResource EmptyStateIconSize}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="{x:Bind ViewModel.EmptyGlyph, Mode=OneWay}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.EmptySubtitle, Mode=OneWay}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Border
            x:Name="UndoSnackbar"
            Grid.Row="3"
            Margin="16"
            Padding="12,8"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource OverlayCornerRadius}"
            Translation="0,0,32"
            x:Load="{x:Bind ViewModel.IsUndoVisible, Mode=OneWay}">
            <Border.Transitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="24" />
                </TransitionCollection>
            </Border.Transitions>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{x:Bind ViewModel.UndoMessage, Mode=OneWay}" />
                <Button
                    x:Uid="UndoButton"
                    Grid.Column="1"
                    AutomationProperties.AutomationId="Todo.List.UndoButton"
                    Command="{x:Bind ViewModel.UndoDeleteCommand, Mode=OneTime}"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </Border>

        <TextBlock
            Width="1"
            Height="1"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            IsHitTestVisible="False"
            Opacity="0"
            AutomationProperties.AutomationId="Todo.List.CompletionAnnouncement"
            AutomationProperties.LiveSetting="Assertive"
            Text="{x:Bind ViewModel.CompletionAnnouncement, Mode=OneWay}" />
    </Grid>
</UserControl>
