<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wintodo.Controls.TaskListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Wintodo.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Wintodo.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:Wintodo.ViewModels"
    x:Name="Root"
    d:DesignHeight="720"
    d:DesignWidth="640"
    IsTabStop="False"
    mc:Ignorable="d">

    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="OnFocusComposerAccelerator" />
        <KeyboardAccelerator Key="Enter" Invoked="OnOpenDetailAccelerator" />
        <KeyboardAccelerator Key="Space" Invoked="OnToggleCompletionAccelerator" />
        <KeyboardAccelerator Key="I" Modifiers="Control" Invoked="OnToggleImportanceAccelerator" />
        <KeyboardAccelerator Key="T" Modifiers="Control" Invoked="OnToggleMyDayAccelerator" />
        <KeyboardAccelerator Key="Delete" Invoked="OnDeleteAccelerator" />
        <KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="OnUndoAccelerator" />
        <KeyboardAccelerator Key="F2" Invoked="OnRenameAccelerator" />
        <KeyboardAccelerator Key="Up" Modifiers="Menu" Invoked="OnMoveUpAccelerator" />
        <KeyboardAccelerator Key="Down" Modifiers="Menu" Invoked="OnMoveDownAccelerator" />
        <KeyboardAccelerator Key="Up" Invoked="OnSelectPreviousAccelerator" />
        <KeyboardAccelerator Key="Down" Invoked="OnSelectNextAccelerator" />
    </UserControl.KeyboardAccelerators>

    <UserControl.Resources>
        <CollectionViewSource
            x:Name="TasksCollectionViewSource"
            IsSourceGrouped="True" />

        <!--
            ListViewItemPresenter draws its chrome square regardless of the item's
            CornerRadius, so the row card is templated here instead. Rounding must
            match the composer above the list.
        -->
        <Style x:Key="TaskListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="FocusVisualMargin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border
                            x:Name="ItemCard"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="StateOverlay.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="StateOverlay.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Target="StateOverlay.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                            <Setter Target="SelectionIndicator.Visibility" Value="Visible" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PointerOverSelected">
                                        <VisualState.Setters>
                                            <Setter Target="StateOverlay.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                            <Setter Target="SelectionIndicator.Visibility" Value="Visible" />
                                            <Setter Target="SelectionIndicator.Background" Value="{ThemeResource TaskCardSelectionIndicatorPointerOverBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PressedSelected">
                                        <VisualState.Setters>
                                            <Setter Target="StateOverlay.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                            <Setter Target="SelectionIndicator.Visibility" Value="Visible" />
                                            <Setter Target="SelectionIndicator.Height" Value="10" />
                                            <Setter Target="SelectionIndicator.Background" Value="{ThemeResource TaskCardSelectionIndicatorPressedBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="DisabledStates">
                                    <VisualState x:Name="Enabled" />
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="ItemCard.Opacity" Value="{ThemeResource ListViewItemDisabledThemeOpacity}" />
                                            <Setter Target="SelectionIndicator.Background" Value="{ThemeResource ListViewItemSelectionIndicatorDisabledBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="DragStates">
                                    <VisualState x:Name="NotDragging" />
                                    <VisualState x:Name="Dragging">
                                        <VisualState.Setters>
                                            <Setter Target="ItemCard.Opacity" Value="{ThemeResource ListViewItemDragThemeOpacity}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid>
                                <Border
                                    x:Name="StateOverlay"
                                    Background="{ThemeResource SubtleFillColorTransparentBrush}"
                                    CornerRadius="{TemplateBinding CornerRadius}" />
                                <ContentPresenter
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTransitions="{TemplateBinding ContentTransitions}" />
                                <!-- The Gallery ListViewItemPresenter's resting and pressed pill sizes.
                                     The custom card owns the backplate and keeps its existing hit targets. -->
                                <Border
                                    x:Name="SelectionIndicator"
                                    Width="3"
                                    Height="16"
                                    Margin="4,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AccessibilityView="Raw"
                                    Background="{ThemeResource TaskCardSelectionIndicatorBrush}"
                                    CornerRadius="{ThemeResource ListViewItemSelectionIndicatorCornerRadius}"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TaskGroupHeaderContainerStyle" TargetType="ListViewHeaderItem">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Background" Value="{ThemeResource ListViewHeaderItemBackground}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewHeaderItem">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Background="{TemplateBinding Background}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentTransitions="{TemplateBinding ContentTransitions}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate
            x:Key="TaskRowTemplate"
            x:DataType="viewModels:TaskItemViewModel">
            <controls:TaskRow ViewModel="{x:Bind Mode=OneWay}" />
        </DataTemplate>

        <DataTemplate
            x:Key="GroupHeaderTemplate"
            x:DataType="x:Object">
            <controls:TaskGroupHeader ViewModel="{x:Bind local:TaskListView.GroupMetadata((x:Object)), Mode=OneTime}" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ListIconPickerStates">
                <VisualState x:Name="ListIconPickerIdle" />
                <VisualState x:Name="ListIconPickerRevealed">
                    <VisualState.Setters>
                        <Setter Target="ListIconPlaceholder.Visibility" Value="Collapsed" />
                        <Setter Target="ListIconPickerAffordance.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="UndoStates">
                <VisualStateGroup.Transitions>
                    <VisualTransition From="UndoHidden" To="UndoShown" GeneratedDuration="0:0:0.2">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="UndoSnackbar" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetName="UndoOffset" Storyboard.TargetProperty="Y" From="24" To="0" Duration="0:0:0.2">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </VisualTransition>
                    <VisualTransition From="UndoShown" To="UndoHidden" GeneratedDuration="0:0:0.2">
                        <Storyboard Completed="OnUndoHideCompleted">
                            <DoubleAnimation Storyboard.TargetName="UndoSnackbar" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                        </Storyboard>
                    </VisualTransition>
                </VisualStateGroup.Transitions>
                <VisualState x:Name="UndoHidden">
                    <VisualState.Setters>
                        <Setter Target="UndoSnackbar.Opacity" Value="0" />
                        <Setter Target="UndoOffset.Y" Value="24" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="UndoShown">
                    <VisualState.Setters>
                        <Setter Target="UndoSnackbar.Opacity" Value="1" />
                        <Setter Target="UndoOffset.Y" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="TaskDropStates">
                <VisualState x:Name="TaskDropIdle" />
                <VisualState x:Name="TaskDropAllowed">
                    <VisualState.Setters>
                        <Setter Target="TaskInsertionIndicator.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="64" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition
                MaxWidth="348"
                Width="{x:Bind local:TaskListView.SuggestionsColumnWidth(ViewModel.IsSuggestionsOpen), Mode=OneWay}" />
        </Grid.ColumnDefinitions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Top" Spacing="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        Grid.ColumnSpan="2"
                        Height="44"
                        Orientation="Horizontal"
                        Spacing="8"
                        Visibility="{x:Bind local:TaskListView.InverseBoolToVisibility(ViewModel.CanEditSelectedList), Mode=OneWay}">
                        <FontIcon
                            x:Name="FixedHeaderIcon"
                            Width="44"
                            Height="44"
                            AutomationProperties.AccessibilityView="Raw"
                            AutomationProperties.AutomationId="Todo.List.FixedHeaderIcon"
                            FontSize="{StaticResource ListHeaderIconSize}"
                            Foreground="{x:Bind ViewModel.FixedHeaderIconBrush, Mode=OneWay}"
                            Glyph="{x:Bind ViewModel.FixedHeaderGlyph, Mode=OneWay}"
                            Visibility="{x:Bind local:TaskListView.BoolToVisibility(ViewModel.HasFixedHeaderGlyph), Mode=OneWay}" />
                        <TextBlock
                            x:Name="SmartListTitle"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="Todo.Shell.PageTitle"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            Style="{StaticResource TitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                            TextLineBounds="Tight"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button
                        x:Name="ListIconPickerButton"
                        x:Uid="ListIconPickerButton"
                        Grid.Column="0"
                        Width="44"
                        Height="44"
                        MinWidth="0"
                        Padding="0"
                        AutomationProperties.AutomationId="Todo.List.IconPickerButton"
                        BorderThickness="0"
                        GotFocus="OnListIconPickerFocusChanged"
                        LostFocus="OnListIconPickerFocusChanged"
                        PointerEntered="OnListIconPickerPointerChanged"
                        PointerExited="OnListIconPickerPointerChanged"
                        Style="{StaticResource SubtleButtonStyle}"
                        Visibility="{x:Bind local:TaskListView.BoolToVisibility(ViewModel.CanEditSelectedList), Mode=OneWay}">
                        <Grid>
                            <Grid Visibility="{x:Bind local:TaskListView.InverseBoolToVisibility(ViewModel.HasSelectedIconEmoji), Mode=OneWay}">
                                <Ellipse
                                    x:Name="ListIconPlaceholder"
                                    Width="16"
                                    Height="16"
                                    Margin="0,4,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AccessibilityView="Raw"
                                    AutomationProperties.AutomationId="Todo.List.IconPlaceholder"
                                    Fill="{ThemeResource ListHeaderPlaceholderBrush}" />
                                <SymbolIcon
                                    x:Name="ListIconPickerAffordance"
                                    AutomationProperties.AccessibilityView="Raw"
                                    AutomationProperties.AutomationId="Todo.List.IconPickerAffordance"
                                    Symbol="Emoji"
                                    Visibility="Collapsed" />
                            </Grid>
                            <TextBlock
                                AutomationProperties.AutomationId="Todo.List.HeaderIcon"
                                FontFamily="Segoe UI Emoji"
                                HorizontalAlignment="Center"
                                Style="{StaticResource TitleTextBlockStyle}"
                                Text="{x:Bind ViewModel.SelectedIconEmoji, Mode=OneWay}"
                                TextAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind local:TaskListView.BoolToVisibility(ViewModel.HasSelectedIconEmoji), Mode=OneWay}" />
                        </Grid>
                        <Button.Flyout>
                            <Flyout
                                x:Name="ListIconPickerFlyout"
                                Closed="OnListIconPickerClosed"
                                Placement="BottomEdgeAlignedLeft">
                                <StackPanel Width="260" Spacing="8">
                                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.ListIconChoices, Mode=OneWay}">
                                        <ItemsRepeater.Layout>
                                            <UniformGridLayout
                                                MinColumnSpacing="4"
                                                MinItemHeight="40"
                                                MinItemWidth="40"
                                                MinRowSpacing="4" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="viewModels:ListEmojiChoiceViewModel">
                                                <Button
                                                    Width="40"
                                                    Height="40"
                                                    Padding="0"
                                                    AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneTime}"
                                                    AutomationProperties.Name="{x:Bind Name, Mode=OneTime}"
                                                    Command="{x:Bind SelectCommand, Mode=OneTime}"
                                                    CommandParameter="{x:Bind Emoji, Mode=OneTime}"
                                                    Style="{StaticResource SubtleButtonStyle}"
                                                    ToolTipService.ToolTip="{x:Bind Name, Mode=OneTime}">
                                                    <TextBlock
                                                        FontFamily="Segoe UI Emoji"
                                                        FontSize="{StaticResource ListEmojiPickerIconSize}"
                                                        Text="{x:Bind Emoji, Mode=OneTime}" />
                                                </Button>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                    <Button
                                        x:Uid="ListIconPickerClear"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.AutomationId="Todo.List.IconPicker.Clear"
                                        Command="{x:Bind ViewModel.ChangeListIconCommand, Mode=OneTime}"
                                        CommandParameter="" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <!--
                        Stretch to the 44 px icon row: tight line bounds end the text box
                        at the baseline, and a content-sized button clips descenders.
                    -->
                    <Button
                        x:Name="UserListTitleButton"
                        Grid.Column="1"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch"
                        Padding="8,0"
                        AutomationProperties.AutomationId="Todo.List.TitleButton"
                        BorderThickness="{ThemeResource ListHeaderButtonBorderThickness}"
                        Command="{x:Bind ViewModel.BeginRenameListCommand, Mode=OneTime}"
                        Style="{StaticResource SubtleButtonStyle}"
                        Visibility="{x:Bind local:TaskListView.TitleButtonVisibility(ViewModel.CanEditSelectedList, ViewModel.IsRenamingList), Mode=OneWay}">
                        <TextBlock
                            x:Name="DisplayedListTitle"
                            Foreground="{ThemeResource ListAccentBrush}"
                            Style="{StaticResource TitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                            TextLineBounds="Tight"
                            TextTrimming="CharacterEllipsis" />
                    </Button>
                    <!--
                        The editor keeps the title's own type ramp so the name does not
                        change size or jump when it turns editable.
                    -->
                    <local:TitleEditBox
                        x:Name="RenameListBox"
                        Grid.Column="1"
                        MinWidth="160"
                        Padding="8,4"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="Todo.List.RenameBox"
                        FontSize="{x:Bind DisplayedListTitle.FontSize, Mode=OneWay}"
                        FontWeight="{x:Bind DisplayedListTitle.FontWeight, Mode=OneWay}"
                        Foreground="{ThemeResource ListAccentBrush}"
                        KeyDown="OnRenameListBoxKeyDown"
                        LostFocus="OnRenameListBoxLostFocus"
                        Text="{x:Bind ViewModel.RenameListName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{x:Bind local:TaskListView.BoolToVisibility(ViewModel.IsRenamingList), Mode=OneWay}" />
                </Grid>
            </StackPanel>
            <TextBlock
                Grid.Row="1"
                Grid.ColumnSpan="4"
                HorizontalAlignment="Left"
                AutomationProperties.AutomationId="Todo.Shell.Subtitle"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind local:TaskListView.BoolToVisibility(ViewModel.HasSubtitle), Mode=OneWay}" />

            <DropDownButton
                x:Name="SortButton"
                x:Uid="SortButton"
                Grid.Column="1"
                Margin="8,0,0,0"
                AutomationProperties.AutomationId="Todo.List.SortButton"
                Style="{StaticResource SubtleButtonStyle}"
                Visibility="{x:Bind local:TaskListView.BoolToVisibility(ViewModel.AreListCommandsVisible), Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8CB;" />
                    <TextBlock
                        x:Uid="SortButtonLabel"
                        Style="{StaticResource BodyTextBlockStyle}" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem
                            x:Uid="SortManual"
                            AutomationProperties.AutomationId="Todo.List.Sort.Manual"
                            Command="{x:Bind ViewModel.SortByCommand, Mode=OneTime}"
                            CommandParameter="Manual" />
                        <MenuFlyoutItem
                            x:Uid="SortImportance"
                            AutomationProperties.AutomationId="Todo.List.Sort.Importance"
                            Command="{x:Bind ViewModel.SortByCommand, Mode=OneTime}"
                            CommandParameter="Importance" />
                        <MenuFlyoutItem
                            x:Uid="SortDueDate"
                            AutomationProperties.AutomationId="Todo.List.Sort.DueDate"
                            Command="{x:Bind ViewModel.SortByCommand, Mode=OneTime}"
                            CommandParameter="DueDate" />
                        <MenuFlyoutItem
                            x:Uid="SortAlphabetical"
                            AutomationProperties.AutomationId="Todo.List.Sort.Alphabetical"
                            Command="{x:Bind ViewModel.SortByCommand, Mode=OneTime}"
                            CommandParameter="Alphabetical" />
                        <MenuFlyoutItem
                            x:Uid="SortCreationDate"
                            AutomationProperties.AutomationId="Todo.List.Sort.CreationDate"
                            Command="{x:Bind ViewModel.SortByCommand, Mode=OneTime}"
                            CommandParameter="CreationDate" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem
                            x:Uid="SortReverse"
                            AutomationProperties.AutomationId="Todo.List.Sort.Reverse"
                            Command="{x:Bind ViewModel.ToggleSortDirectionCommand, Mode=OneTime}" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>

            <Button
                x:Name="SuggestionsButton"
                x:Uid="SuggestionsButton"
                Grid.Column="2"
                Width="32"
                Height="32"
                Margin="8,0,0,0"
                Padding="0"
                AutomationProperties.AutomationId="Todo.Suggestions.Open"
                Command="{x:Bind ViewModel.ToggleSuggestionsCommand, Mode=OneTime}"
                Style="{StaticResource SubtleButtonStyle}"
                Visibility="{x:Bind local:TaskListView.BoolToVisibility(ViewModel.HasSubtitle), Mode=OneWay}">
                <FontIcon Glyph="&#xEA80;" />
            </Button>

            <Button
                x:Name="ListMenuButton"
                x:Uid="ListMenuButton"
                Grid.Column="3"
                Width="32"
                Height="32"
                Margin="8,0,0,0"
                Padding="0"
                AutomationProperties.AutomationId="Todo.List.MenuButton"
                Style="{StaticResource SubtleButtonStyle}"
                Visibility="{x:Bind local:TaskListView.BoolToVisibility(ViewModel.AreListCommandsVisible), Mode=OneWay}">
                <FontIcon Glyph="&#xE712;" />
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem
                            x:Uid="RenameListMenu"
                            AutomationProperties.AutomationId="Todo.List.Menu.Rename"
                            Command="{x:Bind ViewModel.BeginRenameListCommand, Mode=OneTime}"
                            IsEnabled="{x:Bind ViewModel.CanEditSelectedList, Mode=OneWay}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE70F;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSubItem
                            x:Uid="ChangeIconMenu"
                            AutomationProperties.AutomationId="Todo.List.Menu.ChangeIcon"
                            IsEnabled="{x:Bind ViewModel.CanEditSelectedList, Mode=OneWay}">
                            <MenuFlyoutSubItem.Icon>
                                <SymbolIcon Symbol="Emoji" />
                            </MenuFlyoutSubItem.Icon>
                            <MenuFlyoutItem
                                x:Uid="CustomListIconMenu"
                                AutomationProperties.AutomationId="Todo.List.Icon.Custom"
                                Command="{x:Bind ViewModel.RequestCustomListIconCommand, Mode=OneTime}" />
                            <MenuFlyoutItem
                                x:Uid="RemoveListIconMenu"
                                AutomationProperties.AutomationId="Todo.List.Icon.Remove"
                                Command="{x:Bind ViewModel.ChangeListIconCommand, Mode=OneTime}"
                                CommandParameter="" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSubItem
                            x:Uid="ChangeThemeMenu"
                            AutomationProperties.AutomationId="Todo.List.Menu.ChangeTheme"
                            IsEnabled="{x:Bind ViewModel.IsUserListSelected, Mode=OneWay}">
                            <MenuFlyoutSubItem.Icon>
                                <FontIcon Glyph="&#xE790;" />
                            </MenuFlyoutSubItem.Icon>
                            <MenuFlyoutItem
                                x:Uid="ThemeBlue"
                                AutomationProperties.AutomationId="Todo.List.Theme.Blue"
                                Command="{x:Bind ViewModel.ChangeListColorCommand, Mode=OneTime}"
                                CommandParameter="Blue">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Foreground="{ThemeResource ListAccentBlueBrush}" Glyph="&#xE915;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                x:Uid="ThemeRed"
                                AutomationProperties.AutomationId="Todo.List.Theme.Red"
                                Command="{x:Bind ViewModel.ChangeListColorCommand, Mode=OneTime}"
                                CommandParameter="Red">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Foreground="{ThemeResource ListAccentRedBrush}" Glyph="&#xE915;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                x:Uid="ThemeOrange"
                                AutomationProperties.AutomationId="Todo.List.Theme.Orange"
                                Command="{x:Bind ViewModel.ChangeListColorCommand, Mode=OneTime}"
                                CommandParameter="Orange">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Foreground="{ThemeResource ListAccentOrangeBrush}" Glyph="&#xE915;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                x:Uid="ThemeYellow"
                                AutomationProperties.AutomationId="Todo.List.Theme.Yellow"
                                Command="{x:Bind ViewModel.ChangeListColorCommand, Mode=OneTime}"
                                CommandParameter="Yellow">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Foreground="{ThemeResource ListAccentYellowBrush}" Glyph="&#xE915;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                x:Uid="ThemeGreen"
                                AutomationProperties.AutomationId="Todo.List.Theme.Green"
                                Command="{x:Bind ViewModel.ChangeListColorCommand, Mode=OneTime}"
                                CommandParameter="Green">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Foreground="{ThemeResource ListAccentGreenBrush}" Glyph="&#xE915;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                x:Uid="ThemeTeal"
                                AutomationProperties.AutomationId="Todo.List.Theme.Teal"
                                Command="{x:Bind ViewModel.ChangeListColorCommand, Mode=OneTime}"
                                CommandParameter="Teal">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Foreground="{ThemeResource ListAccentTealBrush}" Glyph="&#xE915;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                x:Uid="ThemeLime"
                                AutomationProperties.AutomationId="Todo.List.Theme.Lime"
                                Command="{x:Bind ViewModel.ChangeListColorCommand, Mode=OneTime}"
                                CommandParameter="Lime">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Foreground="{ThemeResource ListAccentLimeBrush}" Glyph="&#xE915;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                x:Uid="ThemePurple"
                                AutomationProperties.AutomationId="Todo.List.Theme.Purple"
                                Command="{x:Bind ViewModel.ChangeListColorCommand, Mode=OneTime}"
                                CommandParameter="Purple">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Foreground="{ThemeResource ListAccentPurpleBrush}" Glyph="&#xE915;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                x:Uid="ThemePink"
                                AutomationProperties.AutomationId="Todo.List.Theme.Pink"
                                Command="{x:Bind ViewModel.ChangeListColorCommand, Mode=OneTime}"
                                CommandParameter="Pink">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Foreground="{ThemeResource ListAccentPinkBrush}" Glyph="&#xE915;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                x:Uid="ThemeOlive"
                                AutomationProperties.AutomationId="Todo.List.Theme.Olive"
                                Command="{x:Bind ViewModel.ChangeListColorCommand, Mode=OneTime}"
                                CommandParameter="Olive">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Foreground="{ThemeResource ListAccentOliveBrush}" Glyph="&#xE915;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                x:Uid="ThemeGraphite"
                                AutomationProperties.AutomationId="Todo.List.Theme.Graphite"
                                Command="{x:Bind ViewModel.ChangeListColorCommand, Mode=OneTime}"
                                CommandParameter="Graphite">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Foreground="{ThemeResource ListAccentGraphiteBrush}" Glyph="&#xE915;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                x:Uid="ThemeNavy"
                                AutomationProperties.AutomationId="Todo.List.Theme.Navy"
                                Command="{x:Bind ViewModel.ChangeListColorCommand, Mode=OneTime}"
                                CommandParameter="Navy">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Foreground="{ThemeResource ListAccentNavyBrush}" Glyph="&#xE915;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSubItem
                            x:Uid="ChangeBackgroundMenu"
                            AutomationProperties.AutomationId="Todo.List.Menu.ChangeBackground"
                            IsEnabled="{x:Bind ViewModel.CanChangeSelectedBackground, Mode=OneWay}">
                            <MenuFlyoutSubItem.Icon>
                                <FontIcon Glyph="&#xEB9F;" />
                            </MenuFlyoutSubItem.Icon>
                            <MenuFlyoutItem
                                x:Uid="BackgroundNone"
                                AutomationProperties.AutomationId="Todo.List.Background.None"
                                Command="{x:Bind ViewModel.ChangeListBackgroundCommand, Mode=OneTime}"
                                CommandParameter="None" />
                            <MenuFlyoutItem
                                x:Uid="BackgroundCoast"
                                AutomationProperties.AutomationId="Todo.List.Background.Coast"
                                Command="{x:Bind ViewModel.ChangeListBackgroundCommand, Mode=OneTime}"
                                CommandParameter="Coast" />
                            <MenuFlyoutItem
                                x:Uid="BackgroundForest"
                                AutomationProperties.AutomationId="Todo.List.Background.Forest"
                                Command="{x:Bind ViewModel.ChangeListBackgroundCommand, Mode=OneTime}"
                                CommandParameter="Forest" />
                            <MenuFlyoutItem
                                x:Uid="BackgroundMist"
                                AutomationProperties.AutomationId="Todo.List.Background.Mist"
                                Command="{x:Bind ViewModel.ChangeListBackgroundCommand, Mode=OneTime}"
                                CommandParameter="Mist" />
                            <MenuFlyoutItem
                                x:Uid="BackgroundSunrise"
                                AutomationProperties.AutomationId="Todo.List.Background.Sunrise"
                                Command="{x:Bind ViewModel.ChangeListBackgroundCommand, Mode=OneTime}"
                                CommandParameter="Sunrise" />
                            <MenuFlyoutItem
                                x:Uid="BackgroundIndigo"
                                AutomationProperties.AutomationId="Todo.List.Background.Indigo"
                                Command="{x:Bind ViewModel.ChangeListBackgroundCommand, Mode=OneTime}"
                                CommandParameter="Indigo" />
                            <MenuFlyoutItem
                                x:Uid="BackgroundPetals"
                                AutomationProperties.AutomationId="Todo.List.Background.Petals"
                                Command="{x:Bind ViewModel.ChangeListBackgroundCommand, Mode=OneTime}"
                                CommandParameter="Petals" />
                            <MenuFlyoutItem
                                x:Uid="BackgroundGraphite"
                                AutomationProperties.AutomationId="Todo.List.Background.Graphite"
                                Command="{x:Bind ViewModel.ChangeListBackgroundCommand, Mode=OneTime}"
                                CommandParameter="Graphite" />
                            <MenuFlyoutItem
                                x:Uid="BackgroundField"
                                AutomationProperties.AutomationId="Todo.List.Background.Field"
                                Command="{x:Bind ViewModel.ChangeListBackgroundCommand, Mode=OneTime}"
                                CommandParameter="Field" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutItem
                            AutomationProperties.AutomationId="Todo.List.Menu.ShowCompleted"
                            Command="{x:Bind ViewModel.ToggleShowCompletedCommand, Mode=OneTime}"
                            IsEnabled="{x:Bind ViewModel.IsUserListSelected, Mode=OneWay}"
                            Text="{x:Bind ViewModel.ShowCompletedMenuLabel, Mode=OneWay}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8FB;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem
                            x:Uid="ShortcutsMenu"
                            AutomationProperties.AutomationId="Todo.List.Menu.Shortcuts"
                            Command="{x:Bind ViewModel.RequestShortcutsCommand, Mode=OneTime}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE765;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            x:Uid="ExportListMenu"
                            AutomationProperties.AutomationId="Todo.List.Menu.Export"
                            Command="{x:Bind ViewModel.RequestExportListCommand, Mode=OneTime}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE898;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            x:Uid="DeleteListMenu"
                            AutomationProperties.AutomationId="Todo.List.Menu.Delete"
                            Command="{x:Bind ViewModel.RequestDeleteListCommand, Mode=OneTime}"
                            IsEnabled="{x:Bind ViewModel.CanEditSelectedList, Mode=OneWay}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74D;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <Border
            Grid.Row="1"
            HorizontalAlignment="Right"
            Margin="0,0,0,8"
            Padding="8,0,0,0"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource ControlCornerRadius}"
            Visibility="{x:Bind local:TaskListView.BoolToVisibility(ViewModel.HasNonDefaultSort), Mode=OneWay}">
            <Grid ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="Todo.List.SortLabel"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.SortLabel, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <Button
                    x:Uid="SortResetButton"
                    Grid.Column="1"
                    Width="32"
                    Height="32"
                    MinWidth="0"
                    Padding="0"
                    AutomationProperties.AutomationId="Todo.List.Sort.Reset"
                    Command="{x:Bind ViewModel.ResetSortCommand, Mode=OneTime}"
                    Style="{StaticResource SubtleButtonStyle}">
                    <FontIcon Glyph="&#xE711;" />
                </Button>
            </Grid>
        </Border>

        <controls:AddTaskComposer
            x:Name="Composer"
            Grid.Row="2"
            ViewModel="{x:Bind ViewModel, Mode=OneWay}"
            Visibility="{x:Bind local:TaskListView.BoolToVisibility(ViewModel.IsComposerVisible), Mode=OneWay}" />

        <Grid
            x:Name="TaskContent"
            Grid.Row="4"
            Visibility="{x:Bind local:TaskListView.BoolToVisibility(ViewModel.IsTaskListVisible), Mode=OneWay}">
            <Grid.RowDefinitions>
                <!-- Centering in the upper 80% anchors the empty state at 40% without clipping its caption. -->
                <RowDefinition Height="4*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ListView
                x:Name="TasksList"
                Grid.RowSpan="2"
                AutomationProperties.AutomationId="Todo.List.Tasks"
                AllowDrop="{x:Bind ViewModel.CanReorderTasks, Mode=OneWay}"
                CanDragItems="True"
                ContainerContentChanging="OnContainerContentChanging"
                DragOver="OnTaskDragOver"
                DragLeave="OnTaskDragLeave"
                Drop="OnTaskDrop"
                DragItemsCompleted="OnDragItemsCompleted"
                DragItemsStarting="OnDragItemsStarting"
                IsItemClickEnabled="False"
                IsTabStop="True"
                ItemContainerStyle="{StaticResource TaskListViewItemStyle}"
                ItemsSource="{x:Bind TasksCollectionViewSource.View, Mode=OneWay}"
                ItemTemplate="{StaticResource TaskRowTemplate}"
                PreviewKeyDown="OnTasksListPreviewKeyDown"
                SelectionChanged="OnTaskSelectionChanged"
                SelectionMode="Extended">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel
                            AreStickyGroupHeadersEnabled="False"
                            ItemsUpdatingScrollMode="KeepScrollOffset"
                            Loaded="OnTaskPanelLoaded" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.GroupStyle>
                    <GroupStyle
                        HeaderContainerStyle="{StaticResource TaskGroupHeaderContainerStyle}"
                        HeaderTemplate="{StaticResource GroupHeaderTemplate}"
                        HidesIfEmpty="False" />
                </ListView.GroupStyle>
                <ListView.ItemContainerTransitions>
                    <TransitionCollection>
                        <AddDeleteThemeTransition />
                        <ReorderThemeTransition />
                    </TransitionCollection>
                </ListView.ItemContainerTransitions>
            </ListView>

            <Border
                x:Name="TaskInsertionIndicator"
                Grid.RowSpan="2"
                Height="4"
                VerticalAlignment="Top"
                BorderBrush="{ThemeResource AccentTextFillColorPrimaryBrush}"
                BorderThickness="0,2,0,0"
                IsHitTestVisible="False"
                Visibility="Collapsed" />

            <StackPanel
                x:Name="EmptyState"
                MaxWidth="320"
                VerticalAlignment="Center"
                Spacing="4"
                x:Load="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                <FontIcon
                    Margin="0,0,0,12"
                    FontSize="{StaticResource EmptyStateIconSize}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="{x:Bind ViewModel.EmptyGlyph, Mode=OneWay}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.EmptySubtitle, Mode=OneWay}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Border
            x:Name="UndoSnackbar"
            Grid.Row="4"
            Margin="16"
            Padding="12,8"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource OverlayCornerRadius}"
            Translation="0,0,32"
            x:Load="{x:Bind IsUndoLoaded, Mode=OneWay}">
            <Border.RenderTransform>
                <TranslateTransform x:Name="UndoOffset" />
            </Border.RenderTransform>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{x:Bind ViewModel.UndoMessage, Mode=OneWay}" />
                <Button
                    x:Uid="UndoButton"
                    Grid.Column="1"
                    AutomationProperties.AutomationId="Todo.List.UndoButton"
                    Command="{x:Bind ViewModel.UndoDeleteCommand, Mode=OneTime}"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </Border>

        <TextBlock
            Width="1"
            Height="1"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            IsHitTestVisible="False"
            Opacity="0"
            AutomationProperties.AutomationId="Todo.List.CompletionAnnouncement"
            AutomationProperties.LiveSetting="Assertive"
            Text="{x:Bind ViewModel.CompletionAnnouncement, Mode=OneWay}" />
        <!-- The scrolling surface reaches the shell edges; inset the content instead. -->
        <Border
            x:Name="SuggestionsSidebar"
            Grid.RowSpan="5"
            Grid.Column="1"
            Margin="12,-16,-24,0"
            Padding="16,12,0,0"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0"
            Visibility="{x:Bind local:TaskListView.BoolToVisibility(ViewModel.IsSuggestionsOpen), Mode=OneWay}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,16,8" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Uid="SuggestionsTitle"
                        VerticalAlignment="Center"
                        AutomationProperties.HeadingLevel="Level1"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        TextTrimming="CharacterEllipsis" />
                    <Button
                        x:Name="CloseSuggestionsButton"
                        x:Uid="CloseSuggestionsButton"
                        Grid.Column="1"
                        Width="32"
                        Height="32"
                        Padding="0"
                        AutomationProperties.AutomationId="Todo.Suggestions.Close"
                        Command="{x:Bind ViewModel.ToggleSuggestionsCommand, Mode=OneTime}"
                        Style="{StaticResource SubtleButtonStyle}">
                        <FontIcon Glyph="&#xE711;" />
                    </Button>
                </Grid>
                <TextBlock
                    Grid.Row="1"
                    Margin="0,0,16,8"
                    AutomationProperties.AutomationId="Todo.Suggestions.Status"
                    AutomationProperties.LiveSetting="Polite"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.SuggestionStatus, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind local:TaskListView.BoolToVisibility(ViewModel.HasSuggestionStatus), Mode=OneWay}" />
                <ListView
                    Grid.Row="2"
                    AutomationProperties.AutomationId="Todo.Suggestions.List"
                    x:Uid="SuggestionsList"
                    ItemsSource="{x:Bind ViewModel.Suggestions, Mode=OneWay}"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0,0,20,0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:SuggestionRow">
                            <StackPanel Padding="0,4" Spacing="4">
                                <TextBlock
                                    Margin="0,8,0,0"
                                    AutomationProperties.HeadingLevel="Level2"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind Heading, Mode=OneTime}"
                                    Visibility="{x:Bind local:TaskListView.BoolToVisibility(HasHeading), Mode=OneTime}" />
                                <Grid ColumnSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        Width="36"
                                        Height="36"
                                        Padding="0"
                                        AutomationProperties.AutomationId="{x:Bind CompleteId, Mode=OneTime}"
                                        AutomationProperties.Name="{x:Bind CompleteName, Mode=OneTime}"
                                        Command="{x:Bind CompleteCommand, Mode=OneTime}"
                                        CommandParameter="{x:Bind Mode=OneTime}"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        ToolTipService.ToolTip="{x:Bind CompleteName, Mode=OneTime}">
                                        <Ellipse
                                            Width="20"
                                            Height="20"
                                            Fill="{ThemeResource ControlFillColorDefaultBrush}"
                                            Stroke="{ThemeResource ListAccentBrush}"
                                            StrokeThickness="1.5" />
                                    </Button>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock
                                            MaxLines="2"
                                            Text="{x:Bind Title, Mode=OneTime}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap"
                                            ToolTipService.ToolTip="{x:Bind Title, Mode=OneTime}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            TextTrimming="CharacterEllipsis">
                                            <Run Text="{x:Bind MetadataPrefix, Mode=OneTime}" />
                                            <Run Text="{x:Bind RegularDueDate, Mode=OneTime}" />
                                            <Run
                                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                Text="{x:Bind OverdueDueDate, Mode=OneTime}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Button
                                        Grid.Column="2"
                                        Width="36"
                                        Height="36"
                                        Padding="0"
                                        AutomationProperties.AutomationId="{x:Bind AddId, Mode=OneTime}"
                                        AutomationProperties.Name="{x:Bind AddName, Mode=OneTime}"
                                        Command="{x:Bind AddCommand, Mode=OneTime}"
                                        CommandParameter="{x:Bind Mode=OneTime}"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        ToolTipService.ToolTip="{x:Bind AddName, Mode=OneTime}">
                                        <SymbolIcon Symbol="Add" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</UserControl>
