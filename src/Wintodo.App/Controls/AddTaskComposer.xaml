<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wintodo.Controls.AddTaskComposer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Wintodo.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:Wintodo.ViewModels"
    x:Name="Root"
    d:DesignHeight="48"
    d:DesignWidth="560"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style
            x:Key="ComposerChipStyle"
            BasedOn="{StaticResource SubtleButtonStyle}"
            TargetType="DropDownButton">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Border
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="{StaticResource ControlCornerRadius}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ComposerStates">
                <VisualState x:Name="Collapsed">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{x:Bind local:AddTaskComposer.Not(ViewModel.IsComposerExpanded), Mode=OneWay}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="AddGlyph.Opacity" Value="1" />
                        <Setter Target="ComposerCircle.Opacity" Value="0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Expanded">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{x:Bind ViewModel.IsComposerExpanded, Mode=OneWay}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="AddGlyph.Opacity" Value="0" />
                        <Setter Target="ComposerCircle.Opacity" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="ActionLayoutStates">
                <VisualState x:Name="CompactActions">
                    <VisualState.Setters>
                        <Setter Target="InlineOptions.Visibility" Value="Collapsed" />
                        <Setter Target="CompactOptionsButton.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="InlineActions">
                    <VisualState.Setters>
                        <Setter Target="InlineOptions.Visibility" Value="Visible" />
                        <Setter Target="CompactOptionsButton.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid
            x:Name="ComposerGrid"
            MinHeight="48"
            Padding="8,0"
            ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid
                Grid.Column="0"
                Width="32"
                Height="32"
                VerticalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                IsHitTestVisible="False">
                <FontIcon
                    x:Name="AddGlyph"
                    Foreground="{ThemeResource ListAccentBrush}"
                    Glyph="&#xE710;">
                    <FontIcon.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.12" />
                    </FontIcon.OpacityTransition>
                </FontIcon>
                <Ellipse
                    x:Name="ComposerCircle"
                    Width="20"
                    Height="20"
                    Fill="{ThemeResource ControlFillColorDefaultBrush}"
                    Opacity="0"
                    Stroke="{ThemeResource ListAccentBrush}"
                    StrokeThickness="1.5">
                    <Ellipse.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.12" />
                    </Ellipse.OpacityTransition>
                </Ellipse>
            </Grid>

            <TextBox
                x:Name="TaskTitleBox"
                x:Uid="AddTaskBox"
                Grid.Column="1"
                MinHeight="0"
                Padding="4"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="Todo.List.AddTaskBox"
                AcceptsReturn="False"
                Background="{ThemeResource SubtleFillColorTransparentBrush}"
                BorderThickness="0"
                CornerRadius="{StaticResource ControlCornerRadius}"
                GotFocus="OnTaskTitleBoxGotFocus"
                IsEnabled="{x:Bind ViewModel.CanCreateTask, Mode=OneWay}"
                KeyDown="OnTaskTitleBoxKeyDown"
                Text="{x:Bind ViewModel.NewTaskTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.Resources>
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                    <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="TextControlBackgroundDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                </TextBox.Resources>
            </TextBox>

            <StackPanel
                x:Name="ComposerActions"
                Grid.Column="2"
                Loaded="OnComposerActionsLoaded"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="4"
                x:Load="{x:Bind ViewModel.IsComposerExpanded, Mode=OneWay}">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromHorizontalOffset="12" FromVerticalOffset="0" />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>

                <StackPanel x:Name="InlineOptions" Orientation="Horizontal" Spacing="4">
                    <DropDownButton
                        x:Name="TargetListButton"
                        x:Uid="ComposerListButton"
                        AutomationProperties.AutomationId="Todo.Composer.ListButton"
                        Style="{StaticResource ComposerChipStyle}"
                        Visibility="{x:Bind local:AddTaskComposer.BoolToVisibility(ViewModel.IsComposerTargetVisible), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8FD;" />
                            <TextBlock
                                MaxWidth="120"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.ComposerTargetLabel, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout
                                x:Name="TargetListFlyout"
                                Opening="OnTargetListFlyoutOpening" />
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <DropDownButton
                        x:Name="DueDateButton"
                        x:Uid="ComposerDueButton"
                        AutomationProperties.AutomationId="Todo.Composer.DueDateButton"
                        Style="{StaticResource ComposerChipStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE787;" />
                            <TextBlock
                                MaxWidth="72"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.ComposerDueLabel, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{x:Bind local:AddTaskComposer.BoolToVisibility(ViewModel.HasComposerDue), Mode=OneWay}" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem
                                    x:Uid="ComposerDueToday"
                                    AutomationProperties.AutomationId="Todo.Composer.DueToday"
                                    Command="{x:Bind ViewModel.SetComposerDueCommand, Mode=OneTime}"
                                    CommandParameter="Today" />
                                <MenuFlyoutItem
                                    x:Uid="ComposerDueTomorrow"
                                    AutomationProperties.AutomationId="Todo.Composer.DueTomorrow"
                                    Command="{x:Bind ViewModel.SetComposerDueCommand, Mode=OneTime}"
                                    CommandParameter="Tomorrow" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem
                                    x:Uid="ComposerDueClear"
                                    AutomationProperties.AutomationId="Todo.Composer.DueClear"
                                    Command="{x:Bind ViewModel.SetComposerDueCommand, Mode=OneTime}"
                                    CommandParameter="Clear" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <DropDownButton
                        x:Name="ReminderButton"
                        x:Uid="ComposerReminderButton"
                        AutomationProperties.AutomationId="Todo.Composer.ReminderButton"
                        Style="{StaticResource ComposerChipStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7ED;" />
                            <TextBlock
                                MaxWidth="72"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.ComposerReminderLabel, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{x:Bind local:AddTaskComposer.BoolToVisibility(ViewModel.HasComposerReminder), Mode=OneWay}" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem
                                    x:Uid="ComposerReminderLater"
                                    AutomationProperties.AutomationId="Todo.Composer.ReminderLater"
                                    Command="{x:Bind ViewModel.SetComposerReminderCommand, Mode=OneTime}"
                                    CommandParameter="LaterToday" />
                                <MenuFlyoutItem
                                    x:Uid="ComposerReminderTomorrow"
                                    AutomationProperties.AutomationId="Todo.Composer.ReminderTomorrow"
                                    Command="{x:Bind ViewModel.SetComposerReminderCommand, Mode=OneTime}"
                                    CommandParameter="TomorrowMorning" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem
                                    x:Uid="ComposerReminderClear"
                                    AutomationProperties.AutomationId="Todo.Composer.ReminderClear"
                                    Command="{x:Bind ViewModel.SetComposerReminderCommand, Mode=OneTime}"
                                    CommandParameter="Clear" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <DropDownButton
                        x:Name="RepeatButton"
                        x:Uid="ComposerRepeatButton"
                        AutomationProperties.AutomationId="Todo.Composer.RepeatButton"
                        Style="{StaticResource ComposerChipStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8EE;" />
                            <TextBlock
                                MaxWidth="72"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.ComposerRepeatLabel, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{x:Bind local:AddTaskComposer.BoolToVisibility(ViewModel.HasComposerRepeat), Mode=OneWay}" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem
                                    x:Uid="ComposerRepeatDaily"
                                    AutomationProperties.AutomationId="Todo.Composer.RepeatDaily"
                                    Command="{x:Bind ViewModel.SetComposerRepeatCommand, Mode=OneTime}"
                                    CommandParameter="Daily" />
                                <MenuFlyoutItem
                                    x:Uid="ComposerRepeatWeekly"
                                    AutomationProperties.AutomationId="Todo.Composer.RepeatWeekly"
                                    Command="{x:Bind ViewModel.SetComposerRepeatCommand, Mode=OneTime}"
                                    CommandParameter="Weekly" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem
                                    x:Uid="ComposerRepeatClear"
                                    AutomationProperties.AutomationId="Todo.Composer.RepeatClear"
                                    Command="{x:Bind ViewModel.SetComposerRepeatCommand, Mode=OneTime}"
                                    CommandParameter="Clear" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <Rectangle
                        Width="1"
                        Height="20"
                        Margin="4,0"
                        VerticalAlignment="Center"
                        Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                </StackPanel>

                <DropDownButton
                    x:Name="CompactOptionsButton"
                    x:Uid="ComposerOptionsButton"
                    AutomationProperties.AutomationId="Todo.Composer.OptionsButton"
                    Style="{StaticResource ComposerChipStyle}"
                    Visibility="Collapsed">
                    <FontIcon Glyph="&#xE712;" />
                    <DropDownButton.Flyout>
                        <MenuFlyout Opening="OnCompactOptionsOpening">
                            <MenuFlyoutSubItem
                                x:Name="CompactTargetList"
                                x:Uid="ComposerOptionsList"
                                AutomationProperties.AutomationId="Todo.Composer.Options.List"
                                Text="{x:Bind ViewModel.ComposerTargetLabel, Mode=OneWay}"
                                Visibility="{x:Bind local:AddTaskComposer.BoolToVisibility(ViewModel.IsComposerTargetVisible), Mode=OneWay}" />
                            <MenuFlyoutSubItem x:Uid="ComposerOptionsDue" AutomationProperties.AutomationId="Todo.Composer.Options.Due">
                                <MenuFlyoutItem x:Uid="ComposerDueToday" AutomationProperties.AutomationId="Todo.Composer.Options.DueToday"
                                    Command="{x:Bind ViewModel.SetComposerDueCommand, Mode=OneTime}" CommandParameter="Today" />
                                <MenuFlyoutItem x:Uid="ComposerDueTomorrow" AutomationProperties.AutomationId="Todo.Composer.Options.DueTomorrow"
                                    Command="{x:Bind ViewModel.SetComposerDueCommand, Mode=OneTime}" CommandParameter="Tomorrow" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Uid="ComposerDueClear" AutomationProperties.AutomationId="Todo.Composer.Options.DueClear"
                                    Command="{x:Bind ViewModel.SetComposerDueCommand, Mode=OneTime}" CommandParameter="Clear" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSubItem x:Uid="ComposerOptionsReminder" AutomationProperties.AutomationId="Todo.Composer.Options.Reminder">
                                <MenuFlyoutItem x:Uid="ComposerReminderLater" AutomationProperties.AutomationId="Todo.Composer.Options.ReminderLater"
                                    Command="{x:Bind ViewModel.SetComposerReminderCommand, Mode=OneTime}" CommandParameter="LaterToday" />
                                <MenuFlyoutItem x:Uid="ComposerReminderTomorrow" AutomationProperties.AutomationId="Todo.Composer.Options.ReminderTomorrow"
                                    Command="{x:Bind ViewModel.SetComposerReminderCommand, Mode=OneTime}" CommandParameter="TomorrowMorning" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Uid="ComposerReminderClear" AutomationProperties.AutomationId="Todo.Composer.Options.ReminderClear"
                                    Command="{x:Bind ViewModel.SetComposerReminderCommand, Mode=OneTime}" CommandParameter="Clear" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSubItem x:Uid="ComposerOptionsRepeat" AutomationProperties.AutomationId="Todo.Composer.Options.Repeat">
                                <MenuFlyoutItem x:Uid="ComposerRepeatDaily" AutomationProperties.AutomationId="Todo.Composer.Options.RepeatDaily"
                                    Command="{x:Bind ViewModel.SetComposerRepeatCommand, Mode=OneTime}" CommandParameter="Daily" />
                                <MenuFlyoutItem x:Uid="ComposerRepeatWeekly" AutomationProperties.AutomationId="Todo.Composer.Options.RepeatWeekly"
                                    Command="{x:Bind ViewModel.SetComposerRepeatCommand, Mode=OneTime}" CommandParameter="Weekly" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Uid="ComposerRepeatClear" AutomationProperties.AutomationId="Todo.Composer.Options.RepeatClear"
                                    Command="{x:Bind ViewModel.SetComposerRepeatCommand, Mode=OneTime}" CommandParameter="Clear" />
                            </MenuFlyoutSubItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <Button
                    x:Name="AddTaskButton"
                    x:Uid="AddTaskButton"
                    MinWidth="0"
                    Padding="12,4"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="Todo.Composer.AddButton"
                    Command="{x:Bind ViewModel.AddTaskCommand, Mode=OneTime}"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
