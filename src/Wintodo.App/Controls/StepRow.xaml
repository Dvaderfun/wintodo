<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wintodo.Controls.StepRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Wintodo.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    d:DesignHeight="36"
    d:DesignWidth="320"
    IsTabStop="False"
    mc:Ignorable="d">

    <UserControl.Resources>
    </UserControl.Resources>

    <Grid
        x:Name="StepRoot"
        Height="36"
        ColumnSpacing="4"
        AutomationProperties.AutomationId="{x:Bind ViewModel.AutomationId, Mode=OneWay}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="StepCompletionStates">
                <VisualState x:Name="StepActive">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{x:Bind local:StepRow.Not(ViewModel.IsCompleted), Mode=OneWay}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="StepRoot.Opacity" Value="1" />
                        <Setter Target="StepEditor.TextDecorations" Value="None" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="StepCompleted">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{x:Bind ViewModel.IsCompleted, Mode=OneWay}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="StepRoot.Opacity" Value="0.6" />
                        <Setter Target="StepEditor.TextDecorations" Value="Strikethrough" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="32" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="32" />
        </Grid.ColumnDefinitions>
        <ToggleButton
            Grid.Column="0"
            Width="32"
            Height="32"
            Padding="0"
            AutomationProperties.AutomationId="{x:Bind ViewModel.CompleteAutomationId, Mode=OneWay}"
            AutomationProperties.Name="{x:Bind local:StepRow.CompletionName(ViewModel.IsCompleted), Mode=OneWay}"
            Command="{x:Bind ViewModel.ToggleCompletionCommand, Mode=OneWay}"
            IsChecked="{x:Bind ViewModel.IsCompleted, Mode=OneWay}"
            Style="{StaticResource TaskSubtleToggleButtonStyle}">
            <Grid Width="20" Height="20">
                <Ellipse
                    Fill="{ThemeResource SubtleFillColorTransparentBrush}"
                    Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                    StrokeThickness="1" />
                <Ellipse
                    Fill="{ThemeResource ListAccentBrush}"
                    Visibility="{x:Bind local:StepRow.BoolToVisibility(ViewModel.IsCompleted), Mode=OneWay}" />
                <FontIcon
                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                    Glyph="&#xE73E;"
                    Visibility="{x:Bind local:StepRow.BoolToVisibility(ViewModel.IsCompleted), Mode=OneWay}" />
            </Grid>
        </ToggleButton>
        <TextBox
            x:Name="StepEditor"
            Grid.Column="1"
            MinWidth="0"
            VerticalAlignment="Center"
            AutomationProperties.AutomationId="{x:Bind ViewModel.AutomationId, Mode=OneWay}"
            BorderThickness="0"
            Text="{x:Bind ViewModel.Summary, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <Button
            Grid.Column="2"
            Width="32"
            Height="32"
            Padding="0"
            AutomationProperties.AutomationId="{x:Bind ViewModel.DeleteAutomationId, Mode=OneWay}"
            AutomationProperties.Name="{x:Bind local:StepRow.DeleteName(ViewModel.Summary), Mode=OneWay}"
            Command="{x:Bind ViewModel.DeleteCommand, Mode=OneWay}"
            Style="{StaticResource SubtleButtonStyle}">
            <FontIcon Glyph="&#xE711;" />
        </Button>
    </Grid>
</UserControl>
