<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wintodo.Controls.TaskGroupHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Wintodo.Controls"
    IsTabStop="False">
    <Grid
        Visibility="{x:Bind local:TaskListView.GroupHeaderVisibility(ViewModel.Kind), Mode=OneWay}"
        MinHeight="{x:Bind local:TaskListView.GroupHeaderMinHeight(ViewModel.Kind), Mode=OneWay}"
        AutomationProperties.AccessibilityView="Raw">
        <Grid
            Margin="0,8,0,0"
            ColumnSpacing="8"
            Visibility="{x:Bind local:TaskListView.NamedGroupVisibility(ViewModel.Kind), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                AutomationProperties.AutomationId="{x:Bind ViewModel.AutomationId, Mode=OneWay}"
                Foreground="{x:Bind local:TaskListView.GroupHeaderBrush(ViewModel.IsCritical), Mode=OneWay}"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind ViewModel.Title, Mode=OneWay}" />
            <TextBlock
                Grid.Column="1"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.HeaderCount, Mode=OneWay}" />
        </Grid>
        <ToggleButton
            Margin="0,16,0,8"
            MinHeight="40"
            Padding="12,0"
            HorizontalAlignment="Left"
            HorizontalContentAlignment="Left"
            VerticalContentAlignment="Center"
            AutomationProperties.AutomationId="{x:Bind ViewModel.AutomationId, Mode=OneWay}"
            AutomationProperties.Name="{x:Bind ViewModel.AccessibleName, Mode=OneWay}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            Command="{x:Bind ViewModel.ToggleCommand, Mode=OneTime}"
            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
            IsChecked="{x:Bind ViewModel.IsExpanded, Mode=OneWay}"
            Style="{StaticResource TaskSubtleToggleButtonStyle}"
            Visibility="{x:Bind local:TaskListView.CompletedGroupVisibility(ViewModel.Kind), Mode=OneWay}">
            <!--
                These must be real brushes, not StaticResource aliases.
                A header container is recycled every time the group is
                expanded again, and the ThemeResource update pass cannot
                dereference an alias entry: it resolves to Unknown and
                XAML fail-fasts with "Invalid attribute value Unknown
                for property Foreground" (0x800F1001).
            -->
            <ToggleButton.Resources>
                <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="{ThemeResource CardBackgroundFillColorSecondary}" />
                <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="{ThemeResource SubtleFillColorTertiary}" />
                <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{ThemeResource CardBackgroundFillColorDefault}" />
                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{ThemeResource CardBackgroundFillColorSecondary}" />
                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{ThemeResource SubtleFillColorTertiary}" />
                <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{ThemeResource TextFillColorPrimary}" />
                <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="{ThemeResource TextFillColorPrimary}" />
                <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="{ThemeResource TextFillColorSecondary}" />
            </ToggleButton.Resources>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    Grid.Column="0"
                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    FontSize="{ThemeResource ControlContentThemeFontSize}"
                    Glyph="{x:Bind local:TaskListView.CompletedChevron(ViewModel.IsExpanded), Mode=OneWay}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind ViewModel.Title, Mode=OneWay}" />
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.HeaderCount, Mode=OneWay}" />
            </Grid>
        </ToggleButton>
    </Grid>
</UserControl>
