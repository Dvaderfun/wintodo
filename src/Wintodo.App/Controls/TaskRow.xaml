<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wintodo.Controls.TaskRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Wintodo.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:Wintodo.ViewModels"
    x:Name="Root"
    d:DesignHeight="52"
    d:DesignWidth="560"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="CompletionCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid
        x:Name="RowRoot"
        MinHeight="{x:Bind local:TaskRow.RowMinHeight(ViewModel.IsCompactDensity), Mode=OneWay}"
        Padding="{x:Bind local:TaskRow.RowPadding(ViewModel.IsCompactDensity), Mode=OneWay}"
        AutomationProperties.AutomationId="{x:Bind ViewModel.AutomationId, Mode=OneWay}"
        AutomationProperties.Name="{x:Bind ViewModel.AccessibleName, Mode=OneWay}"
        ContextFlyout="{x:Bind RowContextFlyout, Mode=OneTime}"
        PointerEntered="OnPointerEntered"
        PointerExited="OnPointerExited">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CompletionStates">
                <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="0:0:0.2" />
                </VisualStateGroup.Transitions>
                <VisualState x:Name="Active">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{x:Bind local:TaskRow.Not(ViewModel.IsCompleted), Mode=OneWay}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="TaskContent.Opacity" Value="1" />
                        <Setter Target="TaskTitle.TextDecorations" Value="None" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Completed">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{x:Bind ViewModel.IsCompleted, Mode=OneWay}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="TaskContent.Opacity" Value="0.6" />
                        <Setter Target="TaskTitle.TextDecorations" Value="Strikethrough" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="PointerStates">
                <VisualState x:Name="PointerNormal">
                    <VisualState.Setters>
                        <Setter Target="ImportanceButton.Opacity" Value="{x:Bind local:TaskRow.StarOpacity(ViewModel.IsImportant, ViewModel.IsSelected), Mode=OneWay}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                        <Setter Target="ImportanceButton.Opacity" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="DueStates">
                <VisualState x:Name="DueDefault" />
                <VisualState x:Name="DueToday">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{x:Bind ViewModel.IsDueToday, Mode=OneWay}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="MetadataText.Foreground" Value="{ThemeResource ListAccentBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Overdue">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{x:Bind ViewModel.IsOverdue, Mode=OneWay}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="MetadataText.Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="ImportanceStates">
                <VisualState x:Name="NotImportant">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{x:Bind local:TaskRow.Not(ViewModel.IsImportant), Mode=OneWay}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ImportanceIcon.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Important">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{x:Bind ViewModel.IsImportant, Mode=OneWay}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ImportanceIcon.Foreground" Value="{ThemeResource ListAccentBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="32" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="32" />
        </Grid.ColumnDefinitions>

        <Border
            Width="3"
            Height="20"
            Margin="-8,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Background="{ThemeResource ListAccentBrush}"
            CornerRadius="{StaticResource ControlCornerRadius}"
            Visibility="{x:Bind local:TaskRow.BoolToVisibility(ViewModel.IsSelected), Mode=OneWay}" />

        <Grid
            x:Name="CompletionHost"
            Grid.Column="0"
            Width="32"
            Height="32"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <Grid
                Width="20"
                Height="20"
                IsHitTestVisible="False">
                <Ellipse
                    Fill="{ThemeResource ControlFillColorDefaultBrush}"
                    Stroke="{ThemeResource ListAccentBrush}"
                    StrokeThickness="1.5" />
                <Ellipse
                    Fill="{ThemeResource ListAccentBrush}"
                    Opacity="{x:Bind local:TaskRow.BoolToOpacity(ViewModel.IsCompleted), Mode=OneWay}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Opacity="{x:Bind local:TaskRow.HoverMarkOpacity(ViewModel.IsCompleted, CompletionToggle.IsPointerOver), Mode=OneWay}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="&#xE73E;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    Foreground="{ThemeResource CompletionCheckForegroundBrush}"
                    Opacity="{x:Bind local:TaskRow.BoolToOpacity(ViewModel.IsCompleted), Mode=OneWay}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="&#xE73E;">
                    <TextBlock.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.1" />
                    </TextBlock.OpacityTransition>
                </TextBlock>
            </Grid>
            <CheckBox
                x:Name="CompletionToggle"
                Width="32"
                Height="32"
                AutomationProperties.AutomationId="{x:Bind ViewModel.CompleteAutomationId, Mode=OneWay}"
                AutomationProperties.Name="{x:Bind local:TaskRow.CompletionName(ViewModel.IsCompleted), Mode=OneWay}"
                Command="{x:Bind ViewModel.ToggleCompletionCommand, Mode=OneWay}"
                IsChecked="{x:Bind ViewModel.IsCompleted, Mode=OneWay}"
                Style="{StaticResource CompletionCheckBoxStyle}" />
        </Grid>

        <StackPanel
            x:Name="TaskContent"
            Grid.Column="2"
            VerticalAlignment="Center"
            Spacing="0">
            <StackPanel.OpacityTransition>
                <ScalarTransition Duration="0:0:0.2" />
            </StackPanel.OpacityTransition>
            <TextBlock
                x:Name="TaskTitle"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                MaxLines="2"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="{x:Bind ViewModel.Summary, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap"
                Visibility="{x:Bind local:TaskRow.InverseBoolToVisibility(ViewModel.IsEditingTitle), Mode=OneWay}" />
            <TextBox
                x:Name="TaskTitleEditBox"
                x:Uid="TaskEditTitleBox"
                AutomationProperties.AutomationId="{x:Bind ViewModel.EditAutomationId, Mode=OneWay}"
                BorderThickness="0"
                KeyDown="OnTaskTitleEditBoxKeyDown"
                LostFocus="OnTaskTitleEditBoxLostFocus"
                Text="{x:Bind ViewModel.EditTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Visibility="{x:Bind local:TaskRow.BoolToVisibility(ViewModel.IsEditingTitle), Mode=OneWay}" />
            <TextBlock
                x:Name="MetadataText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                MaxLines="1"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.Metadata, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                Visibility="{x:Bind local:TaskRow.SecondLineVisibility(ViewModel.Metadata, ViewModel.IsCompleted), Mode=OneWay}" />
            <TextBlock
                x:Name="CompletionText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                MaxLines="1"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.CompletionDateText, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                Visibility="{x:Bind local:TaskRow.CompletionLineVisibility(ViewModel.CompletionDateText, ViewModel.IsCompleted), Mode=OneWay}" />
        </StackPanel>

        <ToggleButton
            x:Name="ImportanceButton"
            Grid.Column="4"
            Width="32"
            Height="32"
            AutomationProperties.AutomationId="{x:Bind ViewModel.ImportanceAutomationId, Mode=OneWay}"
            AutomationProperties.Name="{x:Bind local:TaskRow.ImportanceName(ViewModel.IsImportant), Mode=OneWay}"
            Command="{x:Bind ViewModel.ToggleImportanceCommand, Mode=OneWay}"
            IsChecked="{x:Bind ViewModel.IsImportant, Mode=OneWay}"
            Opacity="{x:Bind local:TaskRow.StarOpacity(ViewModel.IsImportant, ViewModel.IsSelected), Mode=OneWay}"
            Style="{StaticResource TaskSubtleToggleButtonStyle}">
            <ToggleButton.Resources>
                <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{ThemeResource SubtleFillColorTransparent}" />
                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{ThemeResource SubtleFillColorSecondary}" />
                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{ThemeResource SubtleFillColorTertiary}" />
                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedDisabled" Color="{ThemeResource SubtleFillColorDisabled}" />
            </ToggleButton.Resources>
            <FontIcon
                x:Name="ImportanceIcon"
                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                Glyph="{x:Bind local:TaskRow.ImportanceGlyph(ViewModel.IsImportant), Mode=OneWay}" />
        </ToggleButton>
    </Grid>
</UserControl>
