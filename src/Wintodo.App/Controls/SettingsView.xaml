<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wintodo.Controls.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Wintodo.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settings="using:CommunityToolkit.WinUI.Controls"
    xmlns:viewModels="using:Wintodo.ViewModels"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--
            Group headers follow the Windows Settings ramp: 14px SemiBold, not the
            20px Subtitle ramp, so they read below the 28px page title instead of
            competing with it.
        -->
        <Style
            x:Key="SettingsGroupHeaderStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <!--
            Card actions size to their own label by default, so "Import .ics" and
            "Export all" land on different widths in adjacent cards. A shared
            minimum width keeps the right edge of every action button aligned.
        -->
        <Style
            x:Key="SettingsActionButtonStyle"
            BasedOn="{StaticResource DefaultButtonStyle}"
            TargetType="Button">
            <Setter Property="MinWidth" Value="152" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <!--
        The title lives outside the ScrollViewer in a 64px row so it stays pinned
        and lands on the same baseline and inset as the task list title.
    -->
    <Grid AutomationProperties.AutomationId="Todo.Settings.Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Uid="SettingsTitle"
            Grid.Row="0"
            VerticalAlignment="Top"
            AutomationProperties.AutomationId="Todo.Settings.Title"
            Style="{StaticResource TitleTextBlockStyle}" />

        <ScrollViewer
            x:Name="SettingsScrollViewer"
            Grid.Row="1"
            Padding="0,0,12,48"
            HorizontalContentAlignment="Stretch"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            AutomationProperties.AutomationId="Todo.Settings.ScrollViewer">
            <!--
                A left-aligned StackPanel would size to its own content and leave the
                cards narrow enough to trip SettingsCard's wrap threshold, which is
                what pushes each control below its description. A star column capped
                by MaxWidth fills the viewport instead and still keeps the content
                left-aligned on wide monitors.
            -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="1000" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    x:Name="SettingsPanel"
                    Grid.Column="0"
                    Spacing="24">

                    <StackPanel Spacing="4">
                        <TextBlock
                            x:Uid="SettingsAppearanceHeader"
                            Style="{StaticResource SettingsGroupHeaderStyle}" />

                        <settings:SettingsCard x:Uid="SettingsThemeCard">
                            <settings:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE790;" />
                            </settings:SettingsCard.HeaderIcon>
                            <ComboBox
                                x:Name="ThemeComboBox"
                                x:Uid="SettingsThemeCombo"
                                MinWidth="200"
                                AutomationProperties.AutomationId="Todo.Settings.Theme"
                                SelectedIndex="{x:Bind ViewModel.AppearanceThemeIndex, Mode=TwoWay}">
                                <ComboBoxItem
                                    x:Uid="SettingsThemeSystem"
                                    AutomationProperties.AutomationId="Todo.Settings.Theme.System" />
                                <ComboBoxItem
                                    x:Uid="SettingsThemeLight"
                                    AutomationProperties.AutomationId="Todo.Settings.Theme.Light" />
                                <ComboBoxItem
                                    x:Uid="SettingsThemeDark"
                                    AutomationProperties.AutomationId="Todo.Settings.Theme.Dark" />
                            </ComboBox>
                        </settings:SettingsCard>

                        <settings:SettingsCard x:Uid="SettingsDensityCard">
                            <settings:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE8FD;" />
                            </settings:SettingsCard.HeaderIcon>
                            <ComboBox
                                x:Uid="SettingsDensityCombo"
                                MinWidth="200"
                                AutomationProperties.AutomationId="Todo.Settings.Density"
                                SelectedIndex="{x:Bind ViewModel.DensityIndex, Mode=TwoWay}">
                                <ComboBoxItem
                                    x:Uid="SettingsDensityComfortable"
                                    AutomationProperties.AutomationId="Todo.Settings.Density.Comfortable" />
                                <ComboBoxItem
                                    x:Uid="SettingsDensityCompact"
                                    AutomationProperties.AutomationId="Todo.Settings.Density.Compact" />
                            </ComboBox>
                        </settings:SettingsCard>

                        <settings:SettingsCard x:Uid="SettingsBackgroundsCard">
                            <settings:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xEB9F;" />
                            </settings:SettingsCard.HeaderIcon>
                            <ToggleSwitch
                                x:Uid="SettingsBackgroundsToggle"
                                AutomationProperties.AutomationId="Todo.Settings.ShowBackgrounds"
                                IsOn="{x:Bind ViewModel.ShowListBackgrounds, Mode=TwoWay}" />
                        </settings:SettingsCard>

                        <settings:SettingsCard x:Uid="SettingsFixedCategoryIconTintCard">
                            <settings:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE790;" />
                            </settings:SettingsCard.HeaderIcon>
                            <ToggleSwitch
                                x:Uid="SettingsFixedCategoryIconTintToggle"
                                AutomationProperties.AutomationId="Todo.Settings.TintFixedCategoryIcons"
                                IsOn="{x:Bind ViewModel.TintFixedCategoryIcons, Mode=TwoWay}" />
                        </settings:SettingsCard>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock
                            x:Uid="SettingsWindowsHeader"
                            Style="{StaticResource SettingsGroupHeaderStyle}" />

                        <settings:SettingsCard x:Uid="SettingsLaunchAtLoginCard">
                            <settings:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE713;" />
                            </settings:SettingsCard.HeaderIcon>
                            <ToggleSwitch
                                x:Uid="SettingsLaunchAtLoginToggle"
                                AutomationProperties.AutomationId="Todo.Settings.LaunchAtLogin"
                                IsEnabled="{x:Bind ViewModel.CanChangeLaunchAtLogin, Mode=OneWay}"
                                IsOn="{x:Bind ViewModel.LaunchAtLogin, Mode=TwoWay}" />
                        </settings:SettingsCard>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Uid="SettingsSyncHeader"
                                VerticalAlignment="Center"
                                Style="{StaticResource SettingsGroupHeaderStyle}" />
                            <ProgressRing
                                Grid.Column="1"
                                Width="20"
                                Height="20"
                                AutomationProperties.AutomationId="Todo.Settings.Sync.Progress"
                                IsActive="{x:Bind ViewModel.IsSyncBusy, Mode=OneWay}"
                                Visibility="{x:Bind local:SettingsView.BoolToVisibility(ViewModel.IsSyncBusy), Mode=OneWay}" />
                        </Grid>

                        <!--
                            A failed connect leaves IsSyncConnected false, which hides
                            the account card that carries SyncStatusText — so the error
                            needs its own surface above both cards.
                        -->
                        <InfoBar
                            x:Uid="SettingsSyncErrorBar"
                            AutomationProperties.AutomationId="Todo.Settings.Sync.Error"
                            IsOpen="{x:Bind ViewModel.IsSyncErrorOpen, Mode=TwoWay}"
                            Message="{x:Bind ViewModel.SyncErrorMessage, Mode=OneWay}"
                            Severity="Error" />

                        <settings:SettingsCard
                            x:Uid="SettingsSyncConnectCard"
                            Visibility="{x:Bind local:SettingsView.InvertBoolToVisibility(ViewModel.IsSyncConnected), Mode=OneWay}">
                            <settings:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE774;" />
                            </settings:SettingsCard.HeaderIcon>
                            <Button
                                x:Uid="SettingsSyncConfigureButton"
                                AutomationProperties.AutomationId="Todo.Settings.Sync.Configure"
                                Command="{x:Bind ConfigureCalDavCommand, Mode=OneTime}"
                                Style="{StaticResource SettingsActionButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE713;" />
                                    <TextBlock
                                        x:Uid="SettingsSyncConfigureLabel"
                                        Style="{StaticResource BodyTextBlockStyle}" />
                                </StackPanel>
                            </Button>
                        </settings:SettingsCard>

                        <settings:SettingsCard
                            x:Uid="SettingsSyncAccountCard"
                            Visibility="{x:Bind local:SettingsView.BoolToVisibility(ViewModel.IsSyncConnected), Mode=OneWay}">
                            <settings:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE774;" />
                            </settings:SettingsCard.HeaderIcon>
                            <StackPanel
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="16">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        AutomationProperties.AutomationId="Todo.Settings.Sync.Account"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind ViewModel.SyncAccountDisplayName, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        AutomationProperties.AutomationId="Todo.Settings.Sync.Status"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind ViewModel.SyncStatusText, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button
                                    AutomationProperties.AutomationId="Todo.Settings.Sync.Now"
                                    Command="{x:Bind ViewModel.SyncNowCommand, Mode=OneTime}"
                                    Style="{StaticResource SettingsActionButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE895;" />
                                        <TextBlock x:Uid="SettingsSyncNowLabel" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    AutomationProperties.AutomationId="Todo.Settings.Sync.Disconnect"
                                    Command="{x:Bind ViewModel.DisconnectCalDavCommand, Mode=OneTime}"
                                    Style="{StaticResource SettingsActionButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8BB;" />
                                        <TextBlock x:Uid="SettingsSyncDisconnectLabel" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </settings:SettingsCard>

                        <settings:SettingsExpander
                            x:Uid="SettingsSyncListsCard"
                            IsExpanded="True"
                            ItemsSource="{x:Bind ViewModel.SyncListOptions, Mode=OneWay}"
                            Visibility="{x:Bind local:SettingsView.BoolToVisibility(ViewModel.IsSyncConnected), Mode=OneWay}">
                            <settings:SettingsExpander.HeaderIcon>
                                <FontIcon Glyph="&#xE895;" />
                            </settings:SettingsExpander.HeaderIcon>
                            <settings:SettingsExpander.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:SyncListOptionViewModel">
                                    <settings:SettingsCard Header="{x:Bind DisplayName, Mode=OneTime}">
                                        <ToggleSwitch
                                            AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneTime}"
                                            IsEnabled="{x:Bind IsAvailable, Mode=OneWay}"
                                            IsOn="{x:Bind IsEnabled, Mode=TwoWay}" />
                                    </settings:SettingsCard>
                                </DataTemplate>
                            </settings:SettingsExpander.ItemTemplate>
                        </settings:SettingsExpander>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Uid="SettingsDataHeader"
                                VerticalAlignment="Center"
                                Style="{StaticResource SettingsGroupHeaderStyle}" />
                            <ProgressRing
                                x:Uid="SettingsTransferProgress"
                                Grid.Column="1"
                                Width="20"
                                Height="20"
                                AutomationProperties.AutomationId="Todo.Settings.TransferProgress"
                                IsActive="{x:Bind ViewModel.IsTransferBusy, Mode=OneWay}"
                                Visibility="{x:Bind local:SettingsView.BoolToVisibility(ViewModel.IsTransferBusy), Mode=OneWay}" />
                        </Grid>

                        <settings:SettingsCard x:Uid="SettingsImportCard">
                            <settings:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE8B5;" />
                            </settings:SettingsCard.HeaderIcon>
                            <Button
                                x:Uid="SettingsImportButton"
                                AutomationProperties.AutomationId="Todo.Settings.ImportIcal"
                                Command="{x:Bind ViewModel.ImportIcalCommand, Mode=OneTime}"
                                Style="{StaticResource SettingsActionButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8B5;" />
                                    <TextBlock
                                        x:Uid="SettingsImportLabel"
                                        Style="{StaticResource BodyTextBlockStyle}" />
                                </StackPanel>
                            </Button>
                        </settings:SettingsCard>

                        <settings:SettingsCard x:Uid="SettingsExportCard">
                            <settings:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE898;" />
                            </settings:SettingsCard.HeaderIcon>
                            <Button
                                x:Uid="SettingsExportAllButton"
                                AutomationProperties.AutomationId="Todo.Settings.ExportAll"
                                Command="{x:Bind ViewModel.ExportAllCommand, Mode=OneTime}"
                                Style="{StaticResource SettingsActionButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE898;" />
                                    <TextBlock
                                        x:Uid="SettingsExportAllLabel"
                                        Style="{StaticResource BodyTextBlockStyle}" />
                                </StackPanel>
                            </Button>
                        </settings:SettingsCard>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock
                            x:Uid="SettingsAboutHeader"
                            Style="{StaticResource SettingsGroupHeaderStyle}" />
                        <settings:SettingsCard
                            x:Uid="SettingsVersionCard"
                            Description="{x:Bind VersionText, Mode=OneTime}">
                            <settings:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE946;" />
                            </settings:SettingsCard.HeaderIcon>
                        </settings:SettingsCard>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!--
            DefaultButton="Primary" is what makes Enter submit the form, so the
            credential boxes need no key handler of their own. The dialog stays
            open on a failed connect and reports the reason inline, because the
            page-level InfoBar underneath it is not visible while it is up.
        -->
        <ContentDialog
            x:Name="CalDavDialog"
            x:Uid="CalDavDialog"
            AutomationProperties.AutomationId="Todo.Dialog.CalDav"
            DefaultButton="Primary"
            Closed="OnCalDavDialogClosed"
            IsPrimaryButtonEnabled="{x:Bind local:SettingsView.CanSubmitCalDav(ViewModel.CalDavServerUrl, ViewModel.CalDavUsername, ViewModel.CalDavPassword, ViewModel.IsSyncBusy), Mode=OneWay}"
            Opened="OnCalDavDialogOpened"
            PrimaryButtonClick="OnCalDavDialogPrimaryClick">
            <StackPanel Width="360" Spacing="16">
                <TextBlock
                    x:Uid="CalDavDialogIntro"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    TextWrapping="Wrap" />

                <InfoBar
                    x:Name="CalDavDialogError"
                    x:Uid="CalDavDialogError"
                    AutomationProperties.AutomationId="Todo.Dialog.CalDav.Error"
                    IsClosable="False"
                    IsOpen="False"
                    Severity="Error" />

                <StackPanel Spacing="12">
                    <TextBox
                        x:Name="CalDavServerBox"
                        x:Uid="SettingsSyncServer"
                        AutomationProperties.AutomationId="Todo.Settings.Sync.Server"
                        InputScope="Url"
                        IsEnabled="{x:Bind local:SettingsView.Not(ViewModel.IsSyncBusy), Mode=OneWay}"
                        Text="{x:Bind ViewModel.CalDavServerUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox
                        x:Name="CalDavUsernameBox"
                        x:Uid="SettingsSyncUsername"
                        AutomationProperties.AutomationId="Todo.Settings.Sync.Username"
                        IsEnabled="{x:Bind local:SettingsView.Not(ViewModel.IsSyncBusy), Mode=OneWay}"
                        Text="{x:Bind ViewModel.CalDavUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <PasswordBox
                        x:Name="CalDavPasswordBox"
                        x:Uid="SettingsSyncPassword"
                        AutomationProperties.AutomationId="Todo.Settings.Sync.Password"
                        IsEnabled="{x:Bind local:SettingsView.Not(ViewModel.IsSyncBusy), Mode=OneWay}"
                        Password="{x:Bind ViewModel.CalDavPassword, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel
                    x:Name="CalDavDialogBusy"
                    Orientation="Horizontal"
                    Spacing="12"
                    Visibility="{x:Bind local:SettingsView.BoolToVisibility(ViewModel.IsSyncBusy), Mode=OneWay}">
                    <ProgressRing
                        Width="16"
                        Height="16"
                        IsActive="True" />
                    <TextBlock
                        x:Uid="CalDavDialogBusyLabel"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </StackPanel>
        </ContentDialog>
    </Grid>
</UserControl>
