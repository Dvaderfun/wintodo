<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Wintodo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Wintodo.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Wintodo"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid x:Name="WindowRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            x:Uid="AppTitleBar"
            AutomationProperties.AutomationId="Todo.TitleBar.Root">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <controls:ResponsiveTitleSearch
            x:Name="TitleSearch"
            Grid.Row="0"
            Width="460"
            Height="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Top" />

        <Frame x:Name="RootFrame" Grid.Row="1" />
    </Grid>
</Window>
