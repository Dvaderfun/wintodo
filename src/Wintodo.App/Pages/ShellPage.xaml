<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Wintodo.Pages.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Wintodo.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:Wintodo.ViewModels"
    x:Name="RootPage"
    mc:Ignorable="d">

    <Grid x:Name="ShellRoot">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ShellResponsiveStates">
                <VisualState x:Name="Minimal">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ShellNavigation.PaneDisplayMode" Value="LeftMinimal" />
                        <Setter Target="ShellNavigation.IsPaneOpen" Value="False" />
                        <Setter Target="ShellNavigation.IsPaneToggleButtonVisible" Value="True" />
                        <Setter Target="NewListButton.Visibility" Value="Collapsed" />
                        <Setter Target="NewGroupButton.Visibility" Value="Collapsed" />
                        <Setter Target="ListContentGrid.Padding" Value="64,16,24,0" />
                        <Setter Target="DetailColumn.Width" Value="0" />
                        <Setter Target="DetailHost.(Grid.Column)" Value="0" />
                        <Setter Target="DetailHost.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="DetailHost.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="DetailHost.Width" Value="Auto" />
                        <Setter Target="DetailHost.Margin" Value="48,8,8,8" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="640" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ShellNavigation.PaneDisplayMode" Value="LeftCompact" />
                        <Setter Target="ShellNavigation.IsPaneOpen" Value="False" />
                        <Setter Target="ShellNavigation.IsPaneToggleButtonVisible" Value="False" />
                        <Setter Target="NewListButton.Visibility" Value="Collapsed" />
                        <Setter Target="NewGroupButton.Visibility" Value="Collapsed" />
                        <Setter Target="ListContentGrid.Padding" Value="24,16,24,0" />
                        <Setter Target="DetailColumn.Width" Value="0" />
                        <Setter Target="DetailHost.(Grid.Column)" Value="0" />
                        <Setter Target="DetailHost.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="DetailHost.HorizontalAlignment" Value="Right" />
                        <Setter Target="DetailHost.Width" Value="360" />
                        <Setter Target="DetailHost.Margin" Value="8" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="Overlay">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ShellNavigation.PaneDisplayMode" Value="Left" />
                        <Setter Target="ShellNavigation.IsPaneOpen" Value="True" />
                        <Setter Target="ShellNavigation.IsPaneToggleButtonVisible" Value="False" />
                        <Setter Target="NewListButton.Visibility" Value="Visible" />
                        <Setter Target="NewGroupButton.Visibility" Value="Visible" />
                        <Setter Target="ListContentGrid.Padding" Value="24,16,24,0" />
                        <Setter Target="DetailColumn.Width" Value="0" />
                        <Setter Target="DetailHost.(Grid.Column)" Value="0" />
                        <Setter Target="DetailHost.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="DetailHost.HorizontalAlignment" Value="Right" />
                        <Setter Target="DetailHost.Width" Value="360" />
                        <Setter Target="DetailHost.Margin" Value="8" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1100" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ShellNavigation.PaneDisplayMode" Value="Left" />
                        <Setter Target="ShellNavigation.IsPaneOpen" Value="True" />
                        <Setter Target="ShellNavigation.IsPaneToggleButtonVisible" Value="False" />
                        <Setter Target="NewListButton.Visibility" Value="Visible" />
                        <Setter Target="NewGroupButton.Visibility" Value="Visible" />
                        <Setter Target="ListContentGrid.Padding" Value="24,16,24,0" />
                        <Setter Target="DetailColumn.Width" Value="0" />
                        <Setter Target="DetailHost.(Grid.Column)" Value="1" />
                        <Setter Target="DetailHost.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="DetailHost.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="DetailHost.Width" Value="Auto" />
                        <Setter Target="DetailHost.Margin" Value="8" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <NavigationView
            x:Name="ShellNavigation"
            AutomationProperties.AutomationId="Todo.Nav.Root"
            CompactPaneLength="48"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsPaneOpen="False"
            IsSettingsVisible="True"
            OpenPaneLength="300"
            PaneDisplayMode="LeftMinimal"
            SelectionChanged="OnNavigationSelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="MyDayNavigationItem"
                    x:Uid="NavMyDay"
                    AutomationProperties.AutomationId="Todo.Nav.MyDay"
                    IsSelected="True"
                    Tag="smart:my-day">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE706;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="ImportantNavigationItem"
                    x:Uid="NavImportant"
                    AutomationProperties.AutomationId="Todo.Nav.Important"
                    Tag="smart:important">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE735;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="PlannedNavigationItem"
                    x:Uid="NavPlanned"
                    AutomationProperties.AutomationId="Todo.Nav.Planned"
                    Tag="smart:planned">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE787;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="AllNavigationItem"
                    x:Uid="NavAll"
                    AutomationProperties.AutomationId="Todo.Nav.All"
                    Tag="smart:all">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8FD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="CompletedNavigationItem"
                    x:Uid="NavCompleted"
                    AutomationProperties.AutomationId="Todo.Nav.Completed"
                    Tag="smart:completed">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE930;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem
                    x:Name="UserListsNavigationItem"
                    x:Uid="NavLists"
                    AutomationProperties.AutomationId="Todo.Nav.UserLists"
                    MenuItemsSource="{x:Bind UserListNavigationItems, Mode=OneWay}"
                    SelectsOnInvoked="False">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8FD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="32" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="NewListButton"
                        x:Uid="NewListButton"
                        Height="40"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        AutomationProperties.AutomationId="Todo.Nav.NewListButton"
                        IsEnabled="False"
                        Style="{StaticResource SubtleButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <SymbolIcon Symbol="Add" />
                            <TextBlock
                                x:Uid="NewListButtonLabel"
                                Style="{StaticResource BodyTextBlockStyle}" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="NewGroupButton"
                        x:Uid="NewGroupButton"
                        Grid.Column="1"
                        Width="32"
                        Height="32"
                        AutomationProperties.AutomationId="Todo.Nav.NewGroupButton"
                        IsEnabled="False"
                        Style="{StaticResource SubtleButtonStyle}">
                        <SymbolIcon Symbol="NewFolder" />
                    </Button>
                </Grid>
            </NavigationView.PaneFooter>

            <Grid x:Name="ContentGrid" MinWidth="400">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="DetailColumn" Width="360" />
                </Grid.ColumnDefinitions>

                <Border
                    x:Name="ListPane"
                    Grid.Column="0"
                    BorderBrush="{ThemeResource ShellDividerBrush}"
                    BorderThickness="0,0,1,0">
                    <Grid
                        x:Name="ListContentGrid"
                        Padding="24,16,24,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="64" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel VerticalAlignment="Top" Spacing="4">
                            <TextBlock
                                AutomationProperties.AutomationId="Todo.Shell.PageTitle"
                                Style="{StaticResource TitleTextBlockStyle}"
                                Text="{x:Bind ViewModel.SelectedTitle, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                AutomationProperties.AutomationId="Todo.Shell.Subtitle"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.SelectedSubtitle, Mode=OneWay}"
                                Visibility="{x:Bind local:ShellPage.BoolToVisibility(ViewModel.IsMyDaySelected), Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid
                    x:Name="DetailHost"
                    Grid.Column="1"
                    Margin="8"
                    Visibility="Collapsed">
                    <Border
                        x:Name="DetailPane"
                        Background="{ThemeResource ShellDetailBackgroundBrush}"
                        BorderBrush="{ThemeResource ShellDetailBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource OverlayCornerRadius}"
                        Translation="0,0,32"
                        x:Load="False">
                        <Border.Shadow>
                            <ThemeShadow />
                        </Border.Shadow>
                    </Border>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Page>
