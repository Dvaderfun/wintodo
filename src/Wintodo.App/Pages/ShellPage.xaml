<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Wintodo.Pages.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Wintodo.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Wintodo.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sizers="using:CommunityToolkit.WinUI.Controls"
    xmlns:viewModels="using:Wintodo.ViewModels"
    x:Name="RootPage"
    KeyboardAcceleratorPlacementMode="Hidden"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ListAccentBrush" Color="{ThemeResource SystemAccentColorDark2}" />
                    <StaticResource x:Key="ListHeaderPlaceholderBrush" ResourceKey="ListAccentBrush" />
                    <StaticResource x:Key="NavigationViewSelectionIndicatorForeground" ResourceKey="ListAccentBrush" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ListAccentBrush" Color="{ThemeResource SystemAccentColorLight3}" />
                    <StaticResource x:Key="ListHeaderPlaceholderBrush" ResourceKey="ListAccentBrush" />
                    <StaticResource x:Key="NavigationViewSelectionIndicatorForeground" ResourceKey="ListAccentBrush" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="ListAccentBrush" ResourceKey="SystemColorHighlightColorBrush" />
                    <StaticResource x:Key="ListHeaderPlaceholderBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="NavigationViewSelectionIndicatorForeground" ResourceKey="SystemColorHighlightColorBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="L" Modifiers="Control" Invoked="OnNewListAccelerator" />
        <KeyboardAccelerator Key="L" Modifiers="Control,Shift" Invoked="OnNewGroupAccelerator" />
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnFocusSearchAccelerator" />
        <KeyboardAccelerator Key="E" Modifiers="Control" Invoked="OnFocusSearchAccelerator" />
        <KeyboardAccelerator Key="Number1" Modifiers="Control" Invoked="OnSmartListAccelerator" />
        <KeyboardAccelerator Key="Number2" Modifiers="Control" Invoked="OnSmartListAccelerator" />
        <KeyboardAccelerator Key="Number3" Modifiers="Control" Invoked="OnSmartListAccelerator" />
        <KeyboardAccelerator Key="Number4" Modifiers="Control" Invoked="OnSmartListAccelerator" />
        <KeyboardAccelerator Key="Number5" Modifiers="Control" Invoked="OnSmartListAccelerator" />
        <KeyboardAccelerator Key="D" Modifiers="Control,Shift" Invoked="OnDueDateAccelerator" />
        <KeyboardAccelerator Key="R" Modifiers="Control,Shift" Invoked="OnReminderAccelerator" />
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapeAccelerator" />
    </Page.KeyboardAccelerators>

    <Grid x:Name="ShellRoot">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ShellResponsiveStates">
                <VisualState x:Name="Minimal">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ShellNavigation.IsPaneToggleButtonVisible" Value="True" />
                        <Setter Target="NewListButton.Visibility" Value="Collapsed" />
                        <Setter Target="NewGroupButton.Visibility" Value="Collapsed" />
                        <Setter Target="MyDayCountBadge.Visibility" Value="Collapsed" />
                        <Setter Target="ImportantCountBadge.Visibility" Value="Collapsed" />
                        <Setter Target="PlannedCountBadge.Visibility" Value="Collapsed" />
                        <Setter Target="AllCountBadge.Visibility" Value="Collapsed" />
                        <Setter Target="CompletedCountBadge.Visibility" Value="Collapsed" />
                        <Setter Target="ListContentGrid.Padding" Value="64,16,24,0" />
                        <Setter Target="DetailHost.(Grid.Column)" Value="0" />
                        <Setter Target="DetailHost.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="DetailHost.Margin" Value="48,8,8,8" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="640" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ShellNavigation.IsPaneToggleButtonVisible" Value="False" />
                        <Setter Target="NewListButton.Visibility" Value="Collapsed" />
                        <Setter Target="NewGroupButton.Visibility" Value="Collapsed" />
                        <Setter Target="MyDayCountBadge.Visibility" Value="Collapsed" />
                        <Setter Target="ImportantCountBadge.Visibility" Value="Collapsed" />
                        <Setter Target="PlannedCountBadge.Visibility" Value="Collapsed" />
                        <Setter Target="AllCountBadge.Visibility" Value="Collapsed" />
                        <Setter Target="CompletedCountBadge.Visibility" Value="Collapsed" />
                        <Setter Target="ListContentGrid.Padding" Value="24,16,24,0" />
                        <Setter Target="DetailHost.(Grid.Column)" Value="0" />
                        <Setter Target="DetailHost.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="DetailHost.Margin" Value="8" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="Overlay">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ShellNavigation.IsPaneToggleButtonVisible" Value="False" />
                        <Setter Target="NewListButton.Visibility" Value="Visible" />
                        <Setter Target="NewGroupButton.Visibility" Value="Visible" />
                        <Setter Target="ListContentGrid.Padding" Value="24,16,24,0" />
                        <Setter Target="DetailHost.(Grid.Column)" Value="0" />
                        <Setter Target="DetailHost.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="DetailHost.Margin" Value="8" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1100" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ShellNavigation.IsPaneToggleButtonVisible" Value="False" />
                        <Setter Target="NewListButton.Visibility" Value="Visible" />
                        <Setter Target="NewGroupButton.Visibility" Value="Visible" />
                        <Setter Target="ListContentGrid.Padding" Value="24,16,24,0" />
                        <Setter Target="DetailHost.(Grid.Column)" Value="1" />
                        <Setter Target="DetailHost.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="DetailHost.Margin" Value="8" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="DetailPaneStates">
                <VisualStateGroup.Transitions>
                    <VisualTransition
                        To="DetailClosing"
                        GeneratedDuration="0:0:0.15" />
                </VisualStateGroup.Transitions>
                <VisualState x:Name="DetailClosed">
                    <VisualState.Setters>
                        <Setter Target="DetailHost.Visibility" Value="Collapsed" />
                        <Setter Target="DetailContent.Opacity" Value="0" />
                        <Setter Target="DetailContentTranslate.X" Value="32" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="DetailClosing">
                    <VisualState.Setters>
                        <Setter Target="DetailHost.Visibility" Value="Visible" />
                        <Setter Target="DetailContent.Opacity" Value="0" />
                        <Setter Target="DetailContentTranslate.X" Value="32" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="DetailOpen">
                    <VisualState.Setters>
                        <Setter Target="DetailHost.Visibility" Value="Visible" />
                        <Setter Target="DetailContent.Opacity" Value="1" />
                        <Setter Target="DetailContentTranslate.X" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <NavigationView
            x:Name="ShellNavigation"
            AutomationProperties.AutomationId="Todo.Nav.Root"
            CompactModeThresholdWidth="640"
            CompactPaneLength="48"
            ExpandedModeThresholdWidth="900"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsPaneOpen="True"
            IsSettingsVisible="False"
            OpenPaneLength="300"
            PaneDisplayMode="Auto"
            SelectionChanged="OnNavigationSelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="MyDayNavigationItem"
                    x:Uid="NavMyDay"
                    AutomationProperties.AutomationId="Todo.Nav.MyDay"
                    Tag="smart:my-day">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            x:Name="MyDayNavigationIcon"
                            Style="{x:Bind controls:CategoryIconStyles.ForNavigation(ViewModel.MyDayIconColor, IsHighContrast), Mode=OneWay}"
                            Glyph="&#xE706;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge
                            x:Name="MyDayCountBadge"
                            AutomationProperties.AutomationId="Todo.Nav.MyDay.Count"
                            Margin="{StaticResource FixedNavigationCountBadgeMargin}"
                            Style="{StaticResource NavigationTaskCountBadgeStyle}"
                            Value="{x:Bind ViewModel.MyDayTaskCount, Mode=OneWay}"
                            Visibility="{x:Bind local:ShellPage.CountToVisibility(ViewModel.MyDayTaskCount), Mode=OneWay}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="ImportantNavigationItem"
                    x:Uid="NavImportant"
                    AutomationProperties.AutomationId="Todo.Nav.Important"
                    Tag="smart:important">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            x:Name="ImportantNavigationIcon"
                            Style="{x:Bind controls:CategoryIconStyles.ForNavigation(ViewModel.ImportantIconColor, IsHighContrast), Mode=OneWay}"
                            Glyph="&#xE734;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge
                            x:Name="ImportantCountBadge"
                            AutomationProperties.AutomationId="Todo.Nav.Important.Count"
                            Margin="{StaticResource FixedNavigationCountBadgeMargin}"
                            Style="{StaticResource NavigationTaskCountBadgeStyle}"
                            Value="{x:Bind ViewModel.ImportantTaskCount, Mode=OneWay}"
                            Visibility="{x:Bind local:ShellPage.CountToVisibility(ViewModel.ImportantTaskCount), Mode=OneWay}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="PlannedNavigationItem"
                    x:Uid="NavPlanned"
                    AutomationProperties.AutomationId="Todo.Nav.Planned"
                    Tag="smart:planned">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            x:Name="PlannedNavigationIcon"
                            Style="{x:Bind controls:CategoryIconStyles.ForNavigation(ViewModel.PlannedIconColor, IsHighContrast), Mode=OneWay}"
                            Glyph="&#xE787;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge
                            x:Name="PlannedCountBadge"
                            AutomationProperties.AutomationId="Todo.Nav.Planned.Count"
                            Margin="{StaticResource FixedNavigationCountBadgeMargin}"
                            Style="{StaticResource NavigationTaskCountBadgeStyle}"
                            Value="{x:Bind ViewModel.PlannedTaskCount, Mode=OneWay}"
                            Visibility="{x:Bind local:ShellPage.CountToVisibility(ViewModel.PlannedTaskCount), Mode=OneWay}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="AllNavigationItem"
                    x:Uid="NavAll"
                    AutomationProperties.AutomationId="Todo.Nav.All"
                    Tag="smart:all">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            x:Name="AllNavigationIcon"
                            Style="{x:Bind controls:CategoryIconStyles.ForNavigation(ViewModel.AllIconColor, IsHighContrast), Mode=OneWay}"
                            Glyph="&#xE8FD;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge
                            x:Name="AllCountBadge"
                            AutomationProperties.AutomationId="Todo.Nav.All.Count"
                            Margin="{StaticResource FixedNavigationCountBadgeMargin}"
                            Style="{StaticResource NavigationTaskCountBadgeStyle}"
                            Value="{x:Bind ViewModel.AllTaskCount, Mode=OneWay}"
                            Visibility="{x:Bind local:ShellPage.CountToVisibility(ViewModel.AllTaskCount), Mode=OneWay}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="CompletedNavigationItem"
                    x:Uid="NavCompleted"
                    AutomationProperties.AutomationId="Todo.Nav.Completed"
                    Tag="smart:completed">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            x:Name="CompletedNavigationIcon"
                            Style="{x:Bind controls:CategoryIconStyles.ForNavigation(ViewModel.CompletedIconColor, IsHighContrast), Mode=OneWay}"
                            Glyph="&#xE930;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge
                            x:Name="CompletedCountBadge"
                            AutomationProperties.AutomationId="Todo.Nav.Completed.Count"
                            Margin="{StaticResource FixedNavigationCountBadgeMargin}"
                            Style="{StaticResource NavigationTaskCountBadgeStyle}"
                            Value="{x:Bind ViewModel.CompletedTaskCount, Mode=OneWay}"
                            Visibility="{x:Bind local:ShellPage.CountToVisibility(ViewModel.CompletedTaskCount), Mode=OneWay}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="DefaultListNavigationItem"
                    AutomationProperties.AutomationId="Todo.Nav.DefaultList"
                    Visibility="Collapsed">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            x:Name="TasksNavigationIcon"
                            Style="{x:Bind controls:CategoryIconStyles.ForNavigation(ViewModel.TasksIconColor, IsHighContrast), Mode=OneWay}"
                            Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator
                    x:Name="ListsSeparator"
                    AutomationProperties.AutomationId="Todo.Nav.ListsSeparator" />
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem
                    x:Name="SyncStatusNavigationItem"
                    AutomationProperties.AutomationId="Todo.Nav.SyncStatus"
                    IsEnabled="False"
                    SelectsOnInvoked="False"
                    Visibility="{x:Bind local:ShellPage.BoolToVisibility(ViewModel.IsSyncConnected), Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="{x:Bind ViewModel.SyncStatusGlyph, Mode=OneWay}" />
                    </NavigationViewItem.Icon>
                    <TextBlock
                        AutomationProperties.AutomationId="Todo.Nav.SyncStatus.Text"
                        Text="{x:Bind ViewModel.SyncStatusText, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="SettingsNavigationItem"
                    x:Uid="NavSettings"
                    AutomationProperties.AutomationId="Todo.Nav.Settings"
                    Tag="settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <NavigationView.PaneFooter>
                <Grid
                    x:Name="PaneFooterGrid"
                    Margin="4,0,4,4">
                    <Grid.Resources>
                        <!--
                            The name boxes carry the surrounding card's chrome, not their
                            own, so the row reads as one control the way the task composer
                            does.
                        -->
                        <!--
                            A TextBox lays its single line out at the top of whatever
                            height it gets, so the theme's 32px floor leaves the text
                            riding high in a centred row. Dropping the floor lets the
                            box hug its line and centre exactly.
                        -->
                        <x:Double x:Key="TextControlThemeMinHeight">0</x:Double>
                        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                        <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="SubtleFillColorTransparentBrush" />
                        <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                        <Style x:Key="PaneFooterEditorStyle" TargetType="Border">
                            <Setter Property="Height" Value="40" />
                            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
                        </Style>
                    </Grid.Resources>

                    <!--
                        The editor takes the action row's place instead of stacking above
                        it, so naming a list happens where the button was and the footer
                        keeps one 40px row in every mode. The width-driven visual states
                        own the buttons' own Visibility, so the creating state hides them
                        through this host instead — two owners on one property would fight.
                    -->
                    <Grid
                        x:Name="NewItemActionsHost"
                        ColumnSpacing="4"
                        Visibility="{x:Bind local:ShellPage.NewItemActionsVisibility(ViewModel.IsCreatingList, ViewModel.IsCreatingGroup), Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="NewListButton"
                            x:Uid="NewListButton"
                            Height="40"
                            Padding="12,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            AutomationProperties.AutomationId="Todo.Nav.NewListButton"
                            Command="{x:Bind ViewModel.BeginCreateListCommand, Mode=OneTime}"
                            Style="{StaticResource SubtleButtonStyle}">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="12">
                                <FontIcon
                                    FontSize="16"
                                    Glyph="&#xE710;" />
                                <TextBlock
                                    x:Uid="NewListButtonLabel"
                                    Style="{StaticResource BodyTextBlockStyle}" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="NewGroupButton"
                            x:Uid="NewGroupButton"
                            Grid.Column="1"
                            Width="40"
                            Height="40"
                            Padding="0"
                            AutomationProperties.AutomationId="Todo.Nav.NewGroupButton"
                            Command="{x:Bind ViewModel.BeginCreateGroupCommand, Mode=OneTime}"
                            Style="{StaticResource SubtleButtonStyle}">
                            <!-- NewFolder: the folder-with-a-plus Segoe Fluent glyph. -->
                            <FontIcon
                                FontSize="16"
                                Glyph="&#xE8F4;" />
                        </Button>
                    </Grid>

                    <Border
                        x:Name="NewListEditor"
                        Style="{StaticResource PaneFooterEditorStyle}"
                        x:Load="{x:Bind ViewModel.IsCreatingList, Mode=OneWay}">
                        <Grid
                            Padding="12,0"
                            ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Center"
                                AutomationProperties.AccessibilityView="Raw"
                                FontSize="16"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE710;" />
                            <controls:TitleEditBox
                                x:Name="NewListNameBox"
                                x:Uid="NewListNameBox"
                                Grid.Column="1"
                                MinHeight="0"
                                Padding="0"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="Todo.Nav.NewListNameBox"
                                Background="{ThemeResource SubtleFillColorTransparentBrush}"
                                BorderThickness="0"
                                KeyDown="OnNewListNameBoxKeyDown"
                                LostFocus="OnNewListNameBoxLostFocus"
                                Text="{x:Bind ViewModel.NewListName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </Border>

                    <Border
                        x:Name="NewGroupEditor"
                        Style="{StaticResource PaneFooterEditorStyle}"
                        x:Load="{x:Bind ViewModel.IsCreatingGroup, Mode=OneWay}">
                        <Grid
                            Padding="12,0"
                            ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Center"
                                AutomationProperties.AccessibilityView="Raw"
                                FontSize="16"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE8F4;" />
                            <controls:TitleEditBox
                                x:Name="NewGroupNameBox"
                                x:Uid="NewGroupNameBox"
                                Grid.Column="1"
                                MinHeight="0"
                                Padding="0"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="Todo.Nav.NewGroupNameBox"
                                Background="{ThemeResource SubtleFillColorTransparentBrush}"
                                BorderThickness="0"
                                KeyDown="OnNewGroupNameBoxKeyDown"
                                LostFocus="OnNewGroupNameBoxLostFocus"
                                Text="{x:Bind ViewModel.NewGroupName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </Border>
                </Grid>
            </NavigationView.PaneFooter>

            <Grid
                x:Name="ContentGrid"
                MinWidth="400"
                SizeChanged="OnContentGridSizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="DetailColumn" Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    x:Name="ListPane"
                    Grid.Column="0"
                    SizeChanged="OnListPaneSizeChanged">
                    <Grid
                        x:Name="ListPaneLayers">
                        <Image
                            x:Name="ListBackgroundImage"
                            AutomationProperties.AccessibilityView="Raw"
                            IsHitTestVisible="False"
                            Opacity="{ThemeResource ListBackgroundOpacity}"
                            Stretch="UniformToFill" />
                        <Grid
                            x:Name="ListContentGrid"
                            Padding="24,16,24,0">
                            <controls:TaskListView
                                x:Name="TaskList"
                                Margin="0,0,-24,0"
                                Loaded="OnTaskListLoaded"
                                ViewModel="{x:Bind ViewModel.TaskList, Mode=OneWay}"
                                Visibility="{x:Bind controls:TaskListView.BoolToVisibility(ViewModel.IsTaskListVisible), Mode=OneWay}" />
                            <controls:SettingsView
                                x:Name="SettingsContent"
                                ViewModel="{x:Bind ViewModel, Mode=OneWay}"
                                x:Load="{x:Bind ViewModel.IsSettingsContentVisible, Mode=OneWay}" />
                            <controls:WelcomeView
                                x:Name="WelcomeContent"
                                ViewModel="{x:Bind ViewModel, Mode=OneWay}"
                                x:Load="{x:Bind ViewModel.IsWelcomeContentVisible, Mode=OneWay}" />
                            <controls:ImportWizardView
                                x:Name="ImportContent"
                                ViewModel="{x:Bind ViewModel.ImportWizard, Mode=OneWay}"
                                x:Load="{x:Bind ViewModel.IsImportVisible, Mode=OneWay}" />
                        </Grid>
                    </Grid>
                </Border>

                <Grid
                    x:Name="DetailHost"
                    Grid.Column="1"
                    MinWidth="320"
                    MaxWidth="960"
                    Margin="8"
                    HorizontalAlignment="Right"
                    Visibility="Collapsed"
                    SizeChanged="OnDetailHostSizeChanged"
                    Width="{x:Bind ViewModel.DetailPaneWidth, Mode=TwoWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <sizers:ContentSizer
                        x:Uid="DetailPaneSizer"
                        Grid.Column="0"
                        AutomationProperties.AutomationId="Todo.Detail.Sizer"
                        IsDragInverted="True"
                        ManipulationStarted="OnDetailResizeStarted"
                        ManipulationCompleted="OnDetailResizeCompleted"
                        Orientation="Vertical"
                        TargetControl="{x:Bind DetailHost, Mode=OneTime}" />
                    <Border
                        x:Name="DetailPane"
                        Grid.Column="1"
                        Background="{ThemeResource ShellDetailBackgroundBrush}"
                        BorderBrush="{ThemeResource ShellDetailBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource OverlayCornerRadius}">
                        <Border.Shadow>
                            <ThemeShadow />
                        </Border.Shadow>
                        <Grid
                            x:Name="DetailContent"
                            Opacity="0">
                            <Grid.RenderTransform>
                                <TranslateTransform
                                    x:Name="DetailContentTranslate"
                                    X="32" />
                            </Grid.RenderTransform>
                            <controls:TaskDetailView
                                x:Name="TaskDetail"
                                AutomationProperties.AutomationId="Todo.Detail.View"
                                Loaded="OnTaskDetailLoaded"
                                Visibility="{x:Bind local:ShellPage.BoolToVisibility(ViewModel.IsDetailEditorReady), Mode=OneWay}"
                                ViewModel="{x:Bind ViewModel.Detail, Mode=OneWay}"
                                x:Load="{x:Bind ViewModel.IsDetailPaneLoaded, Mode=OneWay}" />
                            <!-- This header can paint without constructing the editor or exposing the previous task. -->
                            <Grid
                                Margin="16"
                                VerticalAlignment="Top"
                                ColumnSpacing="4"
                                RowSpacing="8"
                                Visibility="{x:Bind local:ShellPage.BoolToVisibility(ViewModel.HasDetailPreview), Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="32" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Width="24" Height="24" Margin="0,4,0,0" VerticalAlignment="Top"
                                      AutomationProperties.AccessibilityView="Raw">
                                    <Ellipse Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1" />
                                    <Grid Visibility="{x:Bind local:ShellPage.BoolToVisibility(ViewModel.IsPreviewCompleted), Mode=OneWay}">
                                        <Ellipse Fill="{ThemeResource ListAccentBrush}" />
                                        <FontIcon Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Glyph="&#xE73E;" />
                                    </Grid>
                                </Grid>
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="12,8,8,0"
                                    MaxLines="3"
                                    AutomationProperties.AutomationId="Todo.Detail.PreviewTitle"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{x:Bind ViewModel.DetailPreviewTitle, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                                <FontIcon
                                    Grid.Column="2"
                                    Height="32"
                                    VerticalAlignment="Top"
                                    AutomationProperties.AccessibilityView="Raw"
                                    Foreground="{ThemeResource ListAccentBrush}"
                                    Glyph="{x:Bind controls:TaskDetailView.ImportanceGlyph(ViewModel.IsPreviewImportant), Mode=OneWay}" />
                                <Button
                                    x:Uid="DetailCloseButton"
                                    Grid.Column="3"
                                    Width="32" Height="32" Padding="0" VerticalAlignment="Top"
                                    AutomationProperties.AutomationId="Todo.Detail.PreviewClose"
                                    Command="{x:Bind ViewModel.CloseDetailPreviewCommand, Mode=OneTime}"
                                    Style="{StaticResource SubtleButtonStyle}">
                                    <FontIcon Glyph="&#xE711;" />
                                </Button>
                                <StackPanel
                                    Grid.Row="1" Grid.ColumnSpan="4"
                                    Spacing="8"
                                    Visibility="{x:Bind local:ShellPage.BoolToVisibility(ViewModel.IsDetailLoadError), Mode=OneWay}">
                                    <TextBlock
                                        AutomationProperties.LiveSetting="Polite"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="{x:Bind ViewModel.DetailLoadFailedText, Mode=OneTime}"
                                        TextWrapping="Wrap" />
                                    <Button
                                        x:Uid="DetailLoadRetry"
                                        AutomationProperties.AutomationId="Todo.Detail.RetryOpen"
                                        Command="{x:Bind ViewModel.RetryDetailLoadCommand, Mode=OneTime}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </NavigationView>

        <ContentDialog
            x:Name="SyncConflictDialog"
            x:Uid="SyncConflictDialog"
            AutomationProperties.AutomationId="Todo.Dialog.SyncConflict"
            DefaultButton="Primary"
            Opened="OnSyncConflictDialogOpened"
            x:Load="{x:Bind ViewModel.IsSyncConflictDialogLoaded, Mode=OneWay}">
            <TextBlock
                x:Name="SyncConflictMessage"
                AutomationProperties.AutomationId="Todo.Dialog.SyncConflict.Message"
                Style="{StaticResource BodyTextBlockStyle}"
                TextWrapping="Wrap" />
        </ContentDialog>

        <ContentDialog
            x:Name="ShortcutsDialog"
            x:Uid="ShortcutsDialog"
            AutomationProperties.AutomationId="Todo.Dialog.Shortcuts"
            Opened="OnShortcutsDialogOpened"
            x:Load="{x:Bind ViewModel.IsShortcutsDialogLoaded, Mode=OneWay}">
            <ScrollViewer
                MaxHeight="520"
                AutomationProperties.AutomationId="Todo.Dialog.Shortcuts.Scroll">
                <ItemsRepeater ItemsSource="{x:Bind KeyboardShortcuts, Mode=OneTime}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:ShortcutEntryViewModel">
                            <Grid
                                MinHeight="40"
                                Padding="0,8"
                                ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind Shortcut, Mode=OneTime}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{x:Bind Action, Mode=OneTime}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </ContentDialog>

        <ContentDialog
            x:Name="DeleteListDialog"
            x:Uid="DeleteListDialog"
            AutomationProperties.AutomationId="Todo.Dialog.DeleteList"
            DefaultButton="Close"
            Opened="OnDeleteListDialogOpened"
            x:Load="{x:Bind ViewModel.IsDeleteListDialogLoaded, Mode=OneWay}">
            <TextBlock
                x:Name="DeleteListMessage"
                Style="{StaticResource BodyTextBlockStyle}"
                TextWrapping="Wrap" />
        </ContentDialog>

        <ContentDialog
            x:Name="DeleteTaskDialog"
            x:Uid="DeleteTaskDialog"
            AutomationProperties.AutomationId="Todo.Dialog.DeleteTask"
            DefaultButton="Close"
            Opened="OnDeleteTaskDialogOpened"
            x:Load="{x:Bind ViewModel.IsDeleteTaskDialogLoaded, Mode=OneWay}">
            <TextBlock
                x:Name="DeleteTaskMessage"
                Style="{StaticResource BodyTextBlockStyle}"
                TextWrapping="Wrap" />
        </ContentDialog>

        <ContentDialog
            x:Name="ListIconDialog"
            x:Uid="ListIconDialog"
            AutomationProperties.AutomationId="Todo.Dialog.ListIcon"
            Closing="OnListIconDialogClosing"
            DefaultButton="Primary"
            Opened="OnListIconDialogOpened"
            x:Load="{x:Bind ViewModel.IsListIconDialogLoaded, Mode=OneWay}">
            <StackPanel Spacing="8">
                <TextBox
                    x:Name="ListIconInput"
                    x:Uid="ListIconInput"
                    MaxLength="32"
                    AutomationProperties.AutomationId="Todo.Dialog.ListIcon.Input"
                    Text="{x:Bind ViewModel.CustomListIconInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock
                    AutomationProperties.AutomationId="Todo.Dialog.ListIcon.Error"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.CustomListIconError, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind local:ShellPage.BoolToVisibility(ViewModel.HasCustomListIconError), Mode=OneWay}" />
            </StackPanel>
        </ContentDialog>

        <ContentDialog
            x:Name="ImportPreviewDialog"
            x:Uid="ImportPreviewDialog"
            AutomationProperties.AutomationId="Todo.Dialog.ImportPreview"
            DefaultButton="Primary"
            Opened="OnImportPreviewDialogOpened"
            x:Load="{x:Bind ViewModel.IsImportPreviewDialogLoaded, Mode=OneWay}">
            <TextBlock
                x:Name="ImportPreviewMessage"
                AutomationProperties.AutomationId="Todo.Dialog.ImportPreview.Message"
                Style="{StaticResource BodyTextBlockStyle}"
                TextWrapping="Wrap" />
        </ContentDialog>

        <ContentDialog
            x:Name="ImportErrorDialog"
            x:Uid="ImportErrorDialog"
            AutomationProperties.AutomationId="Todo.Dialog.ImportError"
            DefaultButton="Close"
            Opened="OnImportErrorDialogOpened"
            x:Load="{x:Bind ViewModel.IsImportErrorDialogLoaded, Mode=OneWay}">
            <TextBlock
                x:Name="ImportErrorMessage"
                AutomationProperties.AutomationId="Todo.Dialog.ImportError.Message"
                Style="{StaticResource BodyTextBlockStyle}"
                TextWrapping="Wrap" />
        </ContentDialog>

        <InfoBar
            x:Name="TransferStatusBar"
            MaxWidth="480"
            Margin="16"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            AutomationProperties.AutomationId="Todo.Transfer.Status"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.IsTransferStatusOpen, Mode=OneWay}"
            Message="{x:Bind ViewModel.TransferStatusMessage, Mode=OneWay}"
            Severity="{x:Bind ToInfoBarSeverity(ViewModel.TransferStatusIsError), Mode=OneWay}"
            Title="{x:Bind ViewModel.TransferStatusTitle, Mode=OneWay}" />

        <TextBlock
            Width="1"
            Height="1"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            IsHitTestVisible="False"
            Opacity="0"
            AutomationProperties.AutomationId="Todo.Detail.InstanceCount"
            Text="{x:Bind ViewModel.DetailInstanceCount, Mode=OneWay}" />
    </Grid>
</Page>
