<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Wintodo.Pages.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Wintodo.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Wintodo.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sizers="using:CommunityToolkit.WinUI.Controls"
    xmlns:viewModels="using:Wintodo.ViewModels"
    x:Name="RootPage"
    RequestedTheme="{x:Bind local:ShellPage.ThemeForIndex(ViewModel.AppearanceThemeIndex), Mode=OneWay}"
    mc:Ignorable="d">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="L" Modifiers="Control" Invoked="OnNewListAccelerator" />
        <KeyboardAccelerator Key="L" Modifiers="Control,Shift" Invoked="OnNewGroupAccelerator" />
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnFocusSearchAccelerator" />
        <KeyboardAccelerator Key="E" Modifiers="Control" Invoked="OnFocusSearchAccelerator" />
        <KeyboardAccelerator Key="Number1" Modifiers="Control" Invoked="OnSmartListAccelerator" />
        <KeyboardAccelerator Key="Number2" Modifiers="Control" Invoked="OnSmartListAccelerator" />
        <KeyboardAccelerator Key="Number3" Modifiers="Control" Invoked="OnSmartListAccelerator" />
        <KeyboardAccelerator Key="Number4" Modifiers="Control" Invoked="OnSmartListAccelerator" />
        <KeyboardAccelerator Key="Number5" Modifiers="Control" Invoked="OnSmartListAccelerator" />
        <KeyboardAccelerator Key="D" Modifiers="Control,Shift" Invoked="OnDueDateAccelerator" />
        <KeyboardAccelerator Key="R" Modifiers="Control,Shift" Invoked="OnReminderAccelerator" />
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapeAccelerator" />
    </Page.KeyboardAccelerators>

    <Grid x:Name="ShellRoot">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ShellResponsiveStates">
                <VisualState x:Name="Minimal">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ShellNavigation.PaneDisplayMode" Value="LeftMinimal" />
                        <Setter Target="ShellNavigation.IsPaneOpen" Value="False" />
                        <Setter Target="ShellNavigation.IsPaneToggleButtonVisible" Value="True" />
                        <Setter Target="NewListButton.Visibility" Value="Collapsed" />
                        <Setter Target="NewGroupButton.Visibility" Value="Collapsed" />
                        <Setter Target="ListContentGrid.Padding" Value="64,16,24,0" />
                        <Setter Target="DetailHost.(Grid.Column)" Value="0" />
                        <Setter Target="DetailHost.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="DetailHost.Margin" Value="48,8,8,8" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="640" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ShellNavigation.PaneDisplayMode" Value="LeftCompact" />
                        <Setter Target="ShellNavigation.IsPaneOpen" Value="False" />
                        <Setter Target="ShellNavigation.IsPaneToggleButtonVisible" Value="False" />
                        <Setter Target="NewListButton.Visibility" Value="Collapsed" />
                        <Setter Target="NewGroupButton.Visibility" Value="Collapsed" />
                        <Setter Target="ListContentGrid.Padding" Value="24,16,24,0" />
                        <Setter Target="DetailHost.(Grid.Column)" Value="0" />
                        <Setter Target="DetailHost.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="DetailHost.Margin" Value="8" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="Overlay">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ShellNavigation.PaneDisplayMode" Value="Left" />
                        <Setter Target="ShellNavigation.IsPaneOpen" Value="True" />
                        <Setter Target="ShellNavigation.IsPaneToggleButtonVisible" Value="False" />
                        <Setter Target="NewListButton.Visibility" Value="Visible" />
                        <Setter Target="NewGroupButton.Visibility" Value="Visible" />
                        <Setter Target="ListContentGrid.Padding" Value="24,16,24,0" />
                        <Setter Target="DetailHost.(Grid.Column)" Value="0" />
                        <Setter Target="DetailHost.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="DetailHost.Margin" Value="8" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1100" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ShellNavigation.PaneDisplayMode" Value="Left" />
                        <Setter Target="ShellNavigation.IsPaneOpen" Value="True" />
                        <Setter Target="ShellNavigation.IsPaneToggleButtonVisible" Value="False" />
                        <Setter Target="NewListButton.Visibility" Value="Visible" />
                        <Setter Target="NewGroupButton.Visibility" Value="Visible" />
                        <Setter Target="ListContentGrid.Padding" Value="24,16,24,0" />
                        <Setter Target="DetailHost.(Grid.Column)" Value="1" />
                        <Setter Target="DetailHost.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="DetailHost.Margin" Value="8" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="DetailPaneStates">
                <VisualStateGroup.Transitions>
                    <VisualTransition
                        To="DetailOpen"
                        GeneratedDuration="0:0:0.2" />
                    <VisualTransition
                        To="DetailClosing"
                        GeneratedDuration="0:0:0.15" />
                </VisualStateGroup.Transitions>
                <VisualState x:Name="DetailClosed">
                    <VisualState.Setters>
                        <Setter Target="DetailHost.Visibility" Value="Collapsed" />
                        <Setter Target="DetailContent.Opacity" Value="0" />
                        <Setter Target="DetailContentTranslate.X" Value="32" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="DetailClosing">
                    <VisualState.Setters>
                        <Setter Target="DetailHost.Visibility" Value="Visible" />
                        <Setter Target="DetailContent.Opacity" Value="0" />
                        <Setter Target="DetailContentTranslate.X" Value="32" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="DetailOpen">
                    <VisualState.Setters>
                        <Setter Target="DetailHost.Visibility" Value="Visible" />
                        <Setter Target="DetailContent.Opacity" Value="1" />
                        <Setter Target="DetailContentTranslate.X" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <NavigationView
            x:Name="ShellNavigation"
            AutomationProperties.AutomationId="Todo.Nav.Root"
            CompactPaneLength="48"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsPaneOpen="False"
            IsSettingsVisible="False"
            OpenPaneLength="300"
            PaneDisplayMode="LeftMinimal"
            SelectionChanged="OnNavigationSelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="MyDayNavigationItem"
                    x:Uid="NavMyDay"
                    AutomationProperties.AutomationId="Todo.Nav.MyDay"
                    IsSelected="True"
                    Tag="smart:my-day">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE706;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="ImportantNavigationItem"
                    x:Uid="NavImportant"
                    AutomationProperties.AutomationId="Todo.Nav.Important"
                    Tag="smart:important">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE734;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="PlannedNavigationItem"
                    x:Uid="NavPlanned"
                    AutomationProperties.AutomationId="Todo.Nav.Planned"
                    Tag="smart:planned">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE787;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="AllNavigationItem"
                    x:Uid="NavAll"
                    AutomationProperties.AutomationId="Todo.Nav.All"
                    Tag="smart:all">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8FD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="CompletedNavigationItem"
                    x:Uid="NavCompleted"
                    AutomationProperties.AutomationId="Todo.Nav.Completed"
                    Tag="smart:completed">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE930;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="DefaultListNavigationItem"
                    AutomationProperties.AutomationId="Todo.Nav.DefaultList"
                    Visibility="Collapsed">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator
                    x:Name="ListsSeparator"
                    AutomationProperties.AutomationId="Todo.Nav.ListsSeparator" />
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem
                    x:Name="SettingsNavigationItem"
                    x:Uid="NavSettings"
                    AutomationProperties.AutomationId="Todo.Nav.Settings"
                    Tag="settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <NavigationView.PaneFooter>
                <Grid
                    x:Name="PaneFooterGrid"
                    Margin="4,0,4,4"
                    ColumnSpacing="8"
                    RowSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="32" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="40" />
                    </Grid.RowDefinitions>
                    <TextBox
                        x:Name="NewListNameBox"
                        x:Uid="NewListNameBox"
                        Grid.Row="0"
                        Grid.ColumnSpan="2"
                        AutomationProperties.AutomationId="Todo.Nav.NewListNameBox"
                        KeyDown="OnNewListNameBoxKeyDown"
                        Text="{x:Bind ViewModel.NewListName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        x:Load="{x:Bind ViewModel.IsCreatingList, Mode=OneWay}" />
                    <TextBox
                        x:Name="NewGroupNameBox"
                        x:Uid="NewGroupNameBox"
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        AutomationProperties.AutomationId="Todo.Nav.NewGroupNameBox"
                        KeyDown="OnNewGroupNameBoxKeyDown"
                        Text="{x:Bind ViewModel.NewGroupName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        x:Load="{x:Bind ViewModel.IsCreatingGroup, Mode=OneWay}" />
                    <Button
                        x:Name="NewListButton"
                        x:Uid="NewListButton"
                        Grid.Row="2"
                        Height="40"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        AutomationProperties.AutomationId="Todo.Nav.NewListButton"
                        Command="{x:Bind ViewModel.BeginCreateListCommand, Mode=OneTime}"
                        Style="{StaticResource SubtleButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <SymbolIcon Symbol="Add" />
                            <TextBlock
                                x:Uid="NewListButtonLabel"
                                Style="{StaticResource BodyTextBlockStyle}" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="NewGroupButton"
                        x:Uid="NewGroupButton"
                        Grid.Row="2"
                        Grid.Column="1"
                        Width="32"
                        Height="32"
                        Padding="0"
                        AutomationProperties.AutomationId="Todo.Nav.NewGroupButton"
                        Command="{x:Bind ViewModel.BeginCreateGroupCommand, Mode=OneTime}"
                        Style="{StaticResource SubtleButtonStyle}">
                        <!--
                            Segoe Fluent has no "add group" glyph: NewFolder reads as a
                            folder and AddTo as a circled plus. This is the same mark
                            Microsoft To Do uses — a list card with a plus on its corner.
                        -->
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="16" Height="16">
                                <Rectangle
                                    Canvas.Left="0.6"
                                    Canvas.Top="5"
                                    Width="11"
                                    Height="10"
                                    RadiusX="2"
                                    RadiusY="2"
                                    Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                    StrokeThickness="1.2" />
                                <Rectangle
                                    Canvas.Left="3.6"
                                    Canvas.Top="8"
                                    Width="1.2"
                                    Height="4"
                                    Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                                <Rectangle
                                    Canvas.Left="9.8"
                                    Canvas.Top="2.4"
                                    Width="6"
                                    Height="1.2"
                                    Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                                <Rectangle
                                    Canvas.Left="12.2"
                                    Canvas.Top="0"
                                    Width="1.2"
                                    Height="6"
                                    Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                </Grid>
            </NavigationView.PaneFooter>

            <Grid
                x:Name="ContentGrid"
                MinWidth="400"
                SizeChanged="OnContentGridSizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="DetailColumn" Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    x:Name="ListPane"
                    Grid.Column="0"
                    SizeChanged="OnListPaneSizeChanged">
                    <Grid
                        x:Name="ListPaneLayers">
                        <Image
                            x:Name="ListBackgroundImage"
                            AutomationProperties.AccessibilityView="Raw"
                            IsHitTestVisible="False"
                            Opacity="{ThemeResource ListBackgroundOpacity}"
                            Stretch="UniformToFill" />
                        <Grid
                            x:Name="ListContentGrid"
                            Padding="24,16,24,0">
                            <controls:TaskListView
                                x:Name="TaskList"
                                Loaded="OnTaskListLoaded"
                                ViewModel="{x:Bind ViewModel.TaskList, Mode=OneWay}"
                                Visibility="{x:Bind controls:TaskListView.InverseBoolToVisibility(ViewModel.IsSettingsVisible), Mode=OneWay}" />
                            <controls:SettingsView
                                x:Name="SettingsContent"
                                ViewModel="{x:Bind ViewModel, Mode=OneWay}"
                                x:Load="{x:Bind ViewModel.IsSettingsVisible, Mode=OneWay}" />
                        </Grid>
                    </Grid>
                </Border>

                <Grid
                    x:Name="DetailHost"
                    Grid.Column="1"
                    MinWidth="320"
                    MaxWidth="720"
                    Margin="8"
                    HorizontalAlignment="Right"
                    Visibility="Collapsed"
                    Width="{x:Bind ViewModel.DetailPaneWidth, Mode=TwoWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <sizers:ContentSizer
                        x:Uid="DetailPaneSizer"
                        Grid.Column="0"
                        AutomationProperties.AutomationId="Todo.Detail.Sizer"
                        IsDragInverted="True"
                        Orientation="Vertical"
                        TargetControl="{x:Bind DetailHost, Mode=OneTime}" />
                    <Border
                        x:Name="DetailPane"
                        Grid.Column="1"
                        Background="{ThemeResource ShellDetailBackgroundBrush}"
                        BorderBrush="{ThemeResource ShellDetailBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource OverlayCornerRadius}">
                        <Border.Shadow>
                            <ThemeShadow />
                        </Border.Shadow>
                        <Grid
                            x:Name="DetailContent"
                            Opacity="0">
                            <Grid.RenderTransform>
                                <TranslateTransform
                                    x:Name="DetailContentTranslate"
                                    X="32" />
                            </Grid.RenderTransform>
                            <controls:TaskDetailView
                                x:Name="TaskDetail"
                                AutomationProperties.AutomationId="Todo.Detail.View"
                                Loaded="OnTaskDetailLoaded"
                                ViewModel="{x:Bind ViewModel.Detail, Mode=OneWay}"
                                x:Load="{x:Bind ViewModel.IsDetailPaneLoaded, Mode=OneWay}" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </NavigationView>

        <ContentDialog
            x:Name="ShortcutsDialog"
            x:Uid="ShortcutsDialog"
            AutomationProperties.AutomationId="Todo.Dialog.Shortcuts"
            Opened="OnShortcutsDialogOpened"
            x:Load="{x:Bind ViewModel.IsShortcutsDialogLoaded, Mode=OneWay}">
            <ScrollViewer
                MaxHeight="520"
                AutomationProperties.AutomationId="Todo.Dialog.Shortcuts.Scroll">
                <ItemsRepeater ItemsSource="{x:Bind KeyboardShortcuts, Mode=OneTime}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:ShortcutEntryViewModel">
                            <Grid
                                MinHeight="40"
                                Padding="0,8"
                                ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind Shortcut, Mode=OneTime}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{x:Bind Action, Mode=OneTime}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </ContentDialog>

        <ContentDialog
            x:Name="DeleteListDialog"
            x:Uid="DeleteListDialog"
            AutomationProperties.AutomationId="Todo.Dialog.DeleteList"
            DefaultButton="Close"
            Opened="OnDeleteListDialogOpened"
            x:Load="{x:Bind ViewModel.IsDeleteListDialogLoaded, Mode=OneWay}">
            <TextBlock
                x:Name="DeleteListMessage"
                Style="{StaticResource BodyTextBlockStyle}"
                TextWrapping="Wrap" />
        </ContentDialog>

        <ContentDialog
            x:Name="DeleteTaskDialog"
            x:Uid="DeleteTaskDialog"
            AutomationProperties.AutomationId="Todo.Dialog.DeleteTask"
            DefaultButton="Close"
            Opened="OnDeleteTaskDialogOpened"
            x:Load="{x:Bind ViewModel.IsDeleteTaskDialogLoaded, Mode=OneWay}">
            <TextBlock
                x:Name="DeleteTaskMessage"
                Style="{StaticResource BodyTextBlockStyle}"
                TextWrapping="Wrap" />
        </ContentDialog>

        <ContentDialog
            x:Name="ImportPreviewDialog"
            x:Uid="ImportPreviewDialog"
            AutomationProperties.AutomationId="Todo.Dialog.ImportPreview"
            DefaultButton="Primary"
            Opened="OnImportPreviewDialogOpened"
            x:Load="{x:Bind ViewModel.IsImportPreviewDialogLoaded, Mode=OneWay}">
            <TextBlock
                x:Name="ImportPreviewMessage"
                AutomationProperties.AutomationId="Todo.Dialog.ImportPreview.Message"
                Style="{StaticResource BodyTextBlockStyle}"
                TextWrapping="Wrap" />
        </ContentDialog>

        <ContentDialog
            x:Name="ImportErrorDialog"
            x:Uid="ImportErrorDialog"
            AutomationProperties.AutomationId="Todo.Dialog.ImportError"
            DefaultButton="Close"
            Opened="OnImportErrorDialogOpened"
            x:Load="{x:Bind ViewModel.IsImportErrorDialogLoaded, Mode=OneWay}">
            <TextBlock
                x:Name="ImportErrorMessage"
                AutomationProperties.AutomationId="Todo.Dialog.ImportError.Message"
                Style="{StaticResource BodyTextBlockStyle}"
                TextWrapping="Wrap" />
        </ContentDialog>

        <InfoBar
            x:Name="TransferStatusBar"
            MaxWidth="480"
            Margin="16"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            AutomationProperties.AutomationId="Todo.Transfer.Status"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.IsTransferStatusOpen, Mode=OneWay}"
            Message="{x:Bind ViewModel.TransferStatusMessage, Mode=OneWay}"
            Severity="{x:Bind ToInfoBarSeverity(ViewModel.TransferStatusIsError), Mode=OneWay}"
            Title="{x:Bind ViewModel.TransferStatusTitle, Mode=OneWay}" />

        <TextBlock
            Width="1"
            Height="1"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            IsHitTestVisible="False"
            Opacity="0"
            AutomationProperties.AutomationId="Todo.Detail.InstanceCount"
            Text="{x:Bind ViewModel.DetailInstanceCount, Mode=OneWay}" />
    </Grid>
</Page>
