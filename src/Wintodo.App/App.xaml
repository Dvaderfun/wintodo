<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Wintodo.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Wintodo">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Themes/Colors.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <x:Double x:Key="EmptyStateIconSize">48</x:Double>
            <x:Double x:Key="ListHeaderIconSize">28</x:Double>
            <x:Double x:Key="ListEmojiPickerIconSize">20</x:Double>
            <Thickness x:Key="FixedNavigationCountBadgeMargin">0,0,8,0</Thickness>
            <Style x:Key="NavigationTaskCountBadgeStyle" TargetType="InfoBadge">
                <Setter Property="MinWidth" Value="32" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Padding" Value="8,0,8,0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            </Style>
            <Style x:Key="TaskSubtleToggleButtonStyle" TargetType="ToggleButton">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
                <Setter Property="Padding" Value="0" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
