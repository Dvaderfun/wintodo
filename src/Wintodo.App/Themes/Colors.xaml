<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <StaticResource x:Key="TaskCardSelectionIndicatorBrush" ResourceKey="ListViewItemSelectionIndicatorBrush" />
            <StaticResource x:Key="TaskCardSelectionIndicatorPointerOverBrush" ResourceKey="ListViewItemSelectionIndicatorPointerOverBrush" />
            <StaticResource x:Key="TaskCardSelectionIndicatorPressedBrush" ResourceKey="ListViewItemSelectionIndicatorPressedBrush" />
            <StaticResource x:Key="ListHeaderPlaceholderBrush" ResourceKey="AccentTextFillColorPrimaryBrush" />
            <Thickness x:Key="ListHeaderButtonBorderThickness">1</Thickness>
            <Thickness x:Key="TitleSearchBorderThickness">0</Thickness>
            <StaticResource x:Key="TitleSearchBorderBrush" ResourceKey="ControlStrokeColorDefaultBrush" />
            <StaticResource
                x:Key="ShellDetailBackgroundBrush"
                ResourceKey="SolidBackgroundFillColorTertiaryBrush" />
            <StaticResource
                x:Key="ShellDetailBorderBrush"
                ResourceKey="CardStrokeColorDefaultBrush" />
            <StaticResource
                x:Key="ShellDividerBrush"
                ResourceKey="DividerStrokeColorDefaultBrush" />
            <SolidColorBrush x:Key="ListAccentBrush" Color="{ThemeResource SystemAccentColorDark2}" />
            <StaticResource
                x:Key="CompletionCheckForegroundBrush"
                ResourceKey="TextOnAccentFillColorPrimaryBrush" />
            <x:Double x:Key="ListBackgroundOpacity">0.12</x:Double>
            <SolidColorBrush x:Key="ListAccentBlueBrush" Color="#005FB8" />
            <SolidColorBrush x:Key="ListAccentRedBrush" Color="#B42318" />
            <SolidColorBrush x:Key="ListAccentOrangeBrush" Color="#8A4B00" />
            <SolidColorBrush x:Key="ListAccentYellowBrush" Color="#716000" />
            <SolidColorBrush x:Key="ListAccentGreenBrush" Color="#146C43" />
            <SolidColorBrush x:Key="ListAccentTealBrush" Color="#006B68" />
            <SolidColorBrush x:Key="ListAccentLimeBrush" Color="#536B00" />
            <SolidColorBrush x:Key="ListAccentPurpleBrush" Color="#744DA9" />
            <SolidColorBrush x:Key="ListAccentPinkBrush" Color="#A4266C" />
            <SolidColorBrush x:Key="ListAccentOliveBrush" Color="#5F6424" />
            <SolidColorBrush x:Key="ListAccentGraphiteBrush" Color="#5D5A58" />
            <SolidColorBrush x:Key="ListAccentNavyBrush" Color="#244A7C" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <StaticResource x:Key="TaskCardSelectionIndicatorBrush" ResourceKey="ListViewItemSelectionIndicatorBrush" />
            <StaticResource x:Key="TaskCardSelectionIndicatorPointerOverBrush" ResourceKey="ListViewItemSelectionIndicatorPointerOverBrush" />
            <StaticResource x:Key="TaskCardSelectionIndicatorPressedBrush" ResourceKey="ListViewItemSelectionIndicatorPressedBrush" />
            <StaticResource x:Key="ListHeaderPlaceholderBrush" ResourceKey="AccentTextFillColorPrimaryBrush" />
            <Thickness x:Key="ListHeaderButtonBorderThickness">1</Thickness>
            <Thickness x:Key="TitleSearchBorderThickness">0</Thickness>
            <StaticResource x:Key="TitleSearchBorderBrush" ResourceKey="ControlStrokeColorDefaultBrush" />
            <StaticResource
                x:Key="ShellDetailBackgroundBrush"
                ResourceKey="SolidBackgroundFillColorTertiaryBrush" />
            <StaticResource
                x:Key="ShellDetailBorderBrush"
                ResourceKey="CardStrokeColorDefaultBrush" />
            <StaticResource
                x:Key="ShellDividerBrush"
                ResourceKey="DividerStrokeColorDefaultBrush" />
            <SolidColorBrush x:Key="ListAccentBrush" Color="{ThemeResource SystemAccentColorLight3}" />
            <StaticResource
                x:Key="CompletionCheckForegroundBrush"
                ResourceKey="TextOnAccentFillColorPrimaryBrush" />
            <x:Double x:Key="ListBackgroundOpacity">0.12</x:Double>
            <SolidColorBrush x:Key="ListAccentBlueBrush" Color="#75B6E7" />
            <SolidColorBrush x:Key="ListAccentRedBrush" Color="#FF99A4" />
            <SolidColorBrush x:Key="ListAccentOrangeBrush" Color="#F5B96B" />
            <SolidColorBrush x:Key="ListAccentYellowBrush" Color="#E8D56A" />
            <SolidColorBrush x:Key="ListAccentGreenBrush" Color="#6CCB8E" />
            <SolidColorBrush x:Key="ListAccentTealBrush" Color="#63C6C2" />
            <SolidColorBrush x:Key="ListAccentLimeBrush" Color="#A8C866" />
            <SolidColorBrush x:Key="ListAccentPurpleBrush" Color="#C5A7E8" />
            <SolidColorBrush x:Key="ListAccentPinkBrush" Color="#F0A1C2" />
            <SolidColorBrush x:Key="ListAccentOliveBrush" Color="#C4C878" />
            <SolidColorBrush x:Key="ListAccentGraphiteBrush" Color="#C8C6C4" />
            <SolidColorBrush x:Key="ListAccentNavyBrush" Color="#93B4E7" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <!-- Selected cards keep ButtonFace rather than the stock presenter's Highlight backplate. -->
            <StaticResource x:Key="TaskCardSelectionIndicatorBrush" ResourceKey="SystemColorButtonTextColorBrush" />
            <StaticResource x:Key="TaskCardSelectionIndicatorPointerOverBrush" ResourceKey="SystemColorButtonTextColorBrush" />
            <StaticResource x:Key="TaskCardSelectionIndicatorPressedBrush" ResourceKey="SystemColorButtonTextColorBrush" />
            <StaticResource x:Key="ListHeaderPlaceholderBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <Thickness x:Key="ListHeaderButtonBorderThickness">0</Thickness>
            <Thickness x:Key="TitleSearchBorderThickness">1</Thickness>
            <StaticResource x:Key="TitleSearchBorderBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource
                x:Key="ShellDetailBackgroundBrush"
                ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource
                x:Key="ShellDetailBorderBrush"
                ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource
                x:Key="ShellDividerBrush"
                ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource
                x:Key="ListAccentBrush"
                ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource
                x:Key="CompletionCheckForegroundBrush"
                ResourceKey="SystemColorHighlightTextColorBrush" />
            <x:Double x:Key="ListBackgroundOpacity">0</x:Double>
            <StaticResource
                x:Key="ListAccentBlueBrush"
                ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource
                x:Key="ListAccentRedBrush"
                ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource
                x:Key="ListAccentOrangeBrush"
                ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource
                x:Key="ListAccentYellowBrush"
                ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource
                x:Key="ListAccentGreenBrush"
                ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource
                x:Key="ListAccentTealBrush"
                ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource
                x:Key="ListAccentLimeBrush"
                ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource
                x:Key="ListAccentPurpleBrush"
                ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource
                x:Key="ListAccentPinkBrush"
                ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource
                x:Key="ListAccentOliveBrush"
                ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource
                x:Key="ListAccentGraphiteBrush"
                ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource
                x:Key="ListAccentNavyBrush"
                ResourceKey="SystemColorHighlightColorBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
