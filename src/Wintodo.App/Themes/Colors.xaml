<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <StaticResource
                x:Key="ShellDetailBackgroundBrush"
                ResourceKey="LayerFillColorDefaultBrush" />
            <StaticResource
                x:Key="ShellDetailBorderBrush"
                ResourceKey="CardStrokeColorDefaultBrush" />
            <StaticResource
                x:Key="ShellDividerBrush"
                ResourceKey="DividerStrokeColorDefaultBrush" />
            <StaticResource
                x:Key="ListAccentBrush"
                ResourceKey="AccentTextFillColorPrimaryBrush" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <StaticResource
                x:Key="ShellDetailBackgroundBrush"
                ResourceKey="LayerFillColorDefaultBrush" />
            <StaticResource
                x:Key="ShellDetailBorderBrush"
                ResourceKey="CardStrokeColorDefaultBrush" />
            <StaticResource
                x:Key="ShellDividerBrush"
                ResourceKey="DividerStrokeColorDefaultBrush" />
            <StaticResource
                x:Key="ListAccentBrush"
                ResourceKey="AccentTextFillColorPrimaryBrush" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <StaticResource
                x:Key="ShellDetailBackgroundBrush"
                ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource
                x:Key="ShellDetailBorderBrush"
                ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource
                x:Key="ShellDividerBrush"
                ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource
                x:Key="ListAccentBrush"
                ResourceKey="SystemColorHighlightColorBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
