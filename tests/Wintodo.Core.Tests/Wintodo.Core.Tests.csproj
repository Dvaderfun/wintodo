<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Wintodo.Core\Wintodo.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test the same BCL/Core-only launch policy compiled into the app, without WinUI activation. -->
    <Compile Include="..\..\src\Wintodo.App\Services\LaunchOptions.cs" Link="App\LaunchOptions.cs" />
    <Compile Include="..\..\src\Wintodo.App\Services\FileBackedClock.cs" Link="App\FileBackedClock.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\fixtures\ical\**\*.ics"
             Link="fixtures\ical\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
